<Window x:Class="OrbusRebornManager.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Welcome to Orbus Reborn Manager"
        Width="640" Height="590" MinWidth="640" MinHeight="590"
        ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource InterfaceFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Grid Background="{StaticResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="14,0,0,0">
                        <ContentControl ContentTemplate="{StaticResource OrbusMark}"
                                        Height="26" Width="26"/>
                        <TextBlock Text="Orbus Reborn Manager" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                    <Button Content="×" FontFamily="Segoe UI" FontSize="19"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CloseChromeButton}"
                            Click="Close_Click" ToolTip="Close setup"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="25,22,25,12">
                <Canvas IsHitTestVisible="False" Opacity="0.048" ClipToBounds="True">
                    <ContentControl ContentTemplate="{StaticResource ArcaneRingMotif}"
                                    Width="250" Height="250" Canvas.Right="-40" Canvas.Top="-70"/>
                </Canvas>
                <StackPanel>
                    <TextBlock x:Name="ModeCaption" Text="WELCOME"
                               Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
                    <TextBlock Text="Get started with OrbusVR" FontSize="24"
                               FontFamily="{StaticResource HeadingFont}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Choose your existing game. RebornManager will keep modded copies separate."
                               FontSize="13" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,18"/>

                    <TextBlock Text="1   Find your existing OrbusVR game"
                               FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Border CornerRadius="13" Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                            Padding="14,13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,15,0" VerticalAlignment="Center">
                                <TextBlock Text="Original installation"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="GameLocationText"
                                           Text="Not selected"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12" Margin="0,5,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Browse"
                                    Style="{StaticResource PillButton}"
                                    Padding="14,8" Click="ChooseGame_Click"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="Select the folder containing vrclient.exe. Your original game won't be modified."
                               FontSize="12" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="2,7,0,0"/>

                    <TextBlock Text="2   Where your instances will live"
                               FontSize="14" FontWeight="SemiBold"
                               Margin="0,20,0,8"/>
                    <Border CornerRadius="13" Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                            Padding="14,13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                                <TextBlock Text="Default instance folder"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StorageLocationText" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Change"
                                    Style="{StaticResource PillButton}"
                                    Padding="14,8" Click="ChooseStorage_Click"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="RebornManager uses AppData by default. You can change this later in Settings."
                               FontSize="12" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="2,7,0,0"/>
                    <TextBlock x:Name="PreviewNotice" Visibility="Collapsed"
                               Text="Preview mode: nothing will be registered, copied or changed."
                               Foreground="{StaticResource AccentBrush}" FontSize="12"
                               Margin="0,17,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0"
                    Padding="25,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Not now" Click="Close_Click"
                            HorizontalAlignment="Left" Style="{StaticResource PillButton}"/>
                    <Button x:Name="LibraryButton" Grid.Column="1"
                            Content="Finish setup" Click="Finish_Click"
                            Style="{StaticResource PillButton}" Margin="0,0,10,0"
                            IsEnabled="False"/>
                    <Button x:Name="CreateButton" Grid.Column="2"
                            Content="Create first instance" Click="Create_Click"
                            Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>