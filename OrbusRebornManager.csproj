
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OrbusRebornManager</AssemblyName>
    <RootNamespace>OrbusRebornManager</RootNamespace>
    <Version>0.4.13</Version>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <StartupObject>OrbusRebornManager.App</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="catalog/mods.json"
                      LogicalName="OrbusRebornManager.Catalog.json" />
    <None Update="catalog/mods.example.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
