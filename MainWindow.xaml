
<Window x:Class="OrbusRebornManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Orbus Reborn Manager"
        Width="1210" Height="810"
        WindowStyle="None" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource InterfaceFont}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- A WPF-rendered title bar avoids the mismatched Windows frame. -->
        <Border Grid.Row="0" Background="#202127" BorderBrush="#373940"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="ChromeTitle_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0,0,0">
                    <ContentControl ContentTemplate="{StaticResource OrbusMark}"
                                    Width="27" Height="27"/>
                    <TextBlock Text="Orbus Reborn" FontFamily="{StaticResource HeadingFont}"
                               FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Text="Manager" FontSize="13" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" Margin="7,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="1">
                    <Button Style="{StaticResource ChromeButton}"
                            ToolTip="Minimize" Click="Chrome_Minimize_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}"
                            ToolTip="Maximize or restore" Click="Chrome_Maximize_Click">
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource CloseChromeButton}"
                            ToolTip="Close" Click="Chrome_Close_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="214"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Quiet sidebar: one clear action per row, settings anchored below. -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,20,12,16">
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="7,0,7,10"/>
                        <Button x:Name="NavSettings" Style="{StaticResource SidebarButton}"
                                Click="SimpleSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Margin="0,0,13,0"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="SidebarVersionText" Text="RebornManager"
                                   Foreground="{StaticResource MutedBrush}" FontSize="13"
                                   HorizontalAlignment="Left" Margin="12,10,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="LIBRARY" Style="{StaticResource Eyebrow}"
                                   Margin="12,2,0,14"/>
                        <Button x:Name="NavHome" Style="{StaticResource SidebarButton}"
                                Click="Instances_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Margin="0,0,13,0"/>
                                <TextBlock Text="My Instances" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavBrowse" Style="{StaticResource SidebarButton}"
                                Click="Discover_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Margin="0,0,13,0"/>
                                <TextBlock Text="Client Mods" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavServer" Style="{StaticResource SidebarButton}"
                                Click="ServerMods_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Margin="0,0,13,0"/>
                                <TextBlock Text="Server Mods" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

        <!-- Main content -->
        <Grid Grid.Column="1"
              Margin="25,22,25,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Sparse, decorative Orbus-inspired sigils. These never accept input and
                 remain behind cards/controls; at 4–6% opacity they're atmosphere only. -->
            <Canvas Grid.RowSpan="3" IsHitTestVisible="False"
                    ClipToBounds="True" Opacity="0.055">
                <ContentControl ContentTemplate="{StaticResource ArcaneRingMotif}"
                                Width="330" Height="330" Canvas.Right="-75" Canvas.Top="-35"/>
                <ContentControl ContentTemplate="{StaticResource ArcaneSpiralMotif}"
                                Width="285" Height="285" Canvas.Left="80" Canvas.Bottom="-120"/>
                <ContentControl ContentTemplate="{StaticResource ArcaneHexMotif}"
                                Width="165" Height="165" Canvas.Right="90" Canvas.Bottom="85"/>
            </Canvas>

            <!-- Page heading -->
            <Grid Grid.Row="0" x:Name="PageHeaderGrid"
                  Margin="0,0,0,17">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="PageHeading"
                               Text="Library"
                               FontFamily="{StaticResource HeadingFont}"
                               FontSize="24"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="PageSubtitle"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="13"
                               Margin="0,6,0,0"/>
                </StackPanel>


                <Border x:Name="HeaderStatusCard" Grid.Column="1"
                        Background="#15332F"
                        CornerRadius="20"
                        BorderBrush="#2A554F"
                        BorderThickness="1"
                        Padding="14,8"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                    <TextBlock x:Name="TopStatus"
                               Text="●  Select a game"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"/>
                </Border>
            </Grid>


            <!-- INSTANCE LIBRARY: compact tiles, search and simple filters -->
            <ScrollViewer Grid.Row="1" x:Name="InstancesPanel"
                          FocusVisualStyle="{x:Null}" Focusable="False"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,3,5">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="0,0,12,0">
                            <TextBox x:Name="InstanceSearchText" Padding="37,10,12,10"
                                     TextChanged="InstanceSearch_Changed"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Foreground="{StaticResource MutedBrush}"
                                       Margin="13,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <TextBlock x:Name="InstanceSearchHint" Text="Search instances"
                                       FontSize="13" Foreground="{StaticResource MutedBrush}"
                                       Margin="37,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                        <Button Grid.Column="1" Content="+  New instance"
                                x:Name="HeaderCreateButton"
                                Style="{StaticResource PrimaryButton}"
                                Click="CreateInstance_Click" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Button x:Name="InstanceSortButton" Content="Recently added  ▾"
                                Style="{StaticResource PillButton}" Padding="13,9"
                                Click="OpenInstanceSort_Click" Margin="0,0,9,0">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource InstanceContextMenu}">
                                    <MenuItem Style="{StaticResource InstanceMenuItem}"
                                              Header="Recently added" Tag="recent"
                                              Click="InstanceSortOption_Click"/>
                                    <MenuItem Style="{StaticResource InstanceMenuItem}"
                                              Header="Name: A to Z" Tag="name"
                                              Click="InstanceSortOption_Click"/>
                                    <MenuItem Style="{StaticResource InstanceMenuItem}"
                                              Header="Name: Z to A" Tag="name-desc"
                                              Click="InstanceSortOption_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="InstanceFilterButton" Content="All instances  ▾"
                                Style="{StaticResource PillButton}" Padding="13,9"
                                Click="OpenInstanceFilter_Click">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource InstanceContextMenu}">
                                    <MenuItem Style="{StaticResource InstanceMenuItem}"
                                              Header="All instances" Tag="all"
                                              Click="InstanceFilterOption_Click"/>
                                    <MenuItem Style="{StaticResource InstanceMenuItem}"
                                              Header="Modded copies" Tag="managed"
                                              Click="InstanceFilterOption_Click"/>
                                    <MenuItem Style="{StaticResource InstanceMenuItem}"
                                              Header="Existing installations" Tag="existing"
                                              Click="InstanceFilterOption_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <TextBlock x:Name="InstanceCountText" VerticalAlignment="Center"
                                   Margin="14,0,0,0" FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <Button Content="Add existing game" Click="OpenInstances_Click"
                                Style="{StaticResource PillButton}" Margin="18,0,0,0"
                                Padding="10,6" MinHeight="30"
                                ToolTip="Register an OrbusVR installation you already have"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding InstanceCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="182" MinHeight="220" Margin="0,0,12,12"
                                        Padding="9" CornerRadius="16" BorderThickness="1"
                                        Background="{StaticResource CardBrush}"
                                        Tag="{Binding}" ToolTip="{Binding Readiness}"
                                        Cursor="Hand" MouseLeftButtonUp="InstanceCard_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="#8E749D"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu Style="{StaticResource InstanceContextMenu}"
                                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Style="{StaticResource InstanceMenuItem}"
                                                      Header="Play" Tag="{Binding}" Click="InstancePlay_Click"/>
                                            <MenuItem Style="{StaticResource InstanceMenuItem}"
                                                      Header="View instance" Tag="{Binding}" Click="InstanceManage_Click"/>
                                            <MenuItem Style="{StaticResource InstanceMenuItem}"
                                                      Header="Open folder" Tag="{Binding}" Click="InstanceOpenFolder_Click"/>
                                            <MenuItem Style="{StaticResource InstanceMenuItem}"
                                                      Header="Copy folder path" Tag="{Binding}" Click="InstanceCopyPath_Click"/>
                                            <MenuItem Style="{StaticResource InstanceMenuItem}"
                                                      Header="Remove from list" Tag="{Binding}" Click="InstanceForget_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <Border Height="137" CornerRadius="13"
                                                Background="{Binding CoverBrush}">
                                            <Grid ClipToBounds="True">
                                                <ContentControl ContentTemplate="{StaticResource ArcaneHexMotif}"
                                                                Width="129" Height="129"
                                                                Opacity="0.13"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                IsHitTestVisible="False"/>
                                                <ContentControl ContentTemplate="{StaticResource OrbusMark}"
                                                                Width="77" Height="77" Opacity="0.85"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                
                                                <!-- Actual vector paths are rendered by ContentTemplate.
                                                     These work even without Segoe MDL2 glyph support. -->
                                                <Button Content="More" Style="{StaticResource InstanceMoreButton}"
                                                        Width="32" Height="32"
                                                        Tag="{Binding}" Click="InstanceOptions_Click"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,7,7,0"
                                                        ToolTip="More instance actions"/>
                                                <Button Content="Play" Style="{StaticResource InstancePlayButton}"
                                                        Width="38" Height="37"
                                                        Tag="{Binding}" Click="InstancePlay_Click"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                        Margin="0,0,8,8" ToolTip="Play this instance"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   Margin="3,9,3,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ModCount}" FontSize="13"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="3,5,3,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Kind}" FontSize="13"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="3,4,3,5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="EmptyInstancesPanel" Style="{StaticResource PanelCard}"
                            Padding="40" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="430">
                            <TextBlock Text="Your adventure starts here" FontSize="22"
                                       FontWeight="Bold" TextAlignment="Center"/>
                            <TextBlock Text="Add your OrbusVR installation, then create a separate copy for mods."
                                       FontSize="13" Foreground="{StaticResource MutedBrush}"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,11,0,20"/>
                            <Button Content="Add OrbusVR installation"
                                    HorizontalAlignment="Center" Click="OpenInstances_Click"
                                    Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="NoMatchingInstancesPanel" Style="{StaticResource PanelCard}"
                            Padding="36" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="No matching instances"
                                       FontSize="16" FontWeight="SemiBold" TextAlignment="Center"/>
                            <TextBlock Text="Try another search or change the filter."
                                       FontSize="13" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,9,0,15" TextAlignment="Center"/>
                            <Button Content="Clear search and filters"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource PillButton}"
                                    Click="ClearInstanceFilters_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- INSTANCE DETAILS -->
            <ScrollViewer Grid.Row="1"
                          x:Name="DashboardPanel"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,3,2">

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="CURRENT GAME"
                                       Style="{StaticResource Eyebrow}"/>

                            <TextBlock Text="Manage this installation"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,9,0,7"/>

                            <TextBlock Text="Manage the mod loader and installed mods for this game copy."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>

                            <TextBox x:Name="GamePathText"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     Margin="0,15,0,0"/>

                            <WrapPanel Margin="0,13,0,0">
                                <Button Content="Back to instances"
                                        Click="OpenInstances_Click"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,9,8"/>

                                <Button Content="+ Create a clean copy"
                                        Click="CreateInstance_Click"
                                        Style="{StaticResource PillButton}"
                                        Margin="0,0,0,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- BepInEx -->
                        <Border Grid.Column="0"
                                Style="{StaticResource PanelCard}"
                                Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="MOD LOADER"
                                           Style="{StaticResource Eyebrow}"/>

                                <TextBlock x:Name="LoaderStatusText"
                                           Text="Select a game"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,5"/>

                                <TextBlock Text="BepInEx, installed separately for each game copy."
                                           FontSize="13"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"/>

                                <Button x:Name="InstallLoaderButton"
                                        Content="Install BepInEx"
                                        Click="InstallLoader_Click"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,17,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Mod collection -->
                        <Border Grid.Column="1"
                                Style="{StaticResource PanelCard}"
                                Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="YOUR MODS"
                                           Style="{StaticResource Eyebrow}"/>

                                <TextBlock x:Name="ModsCountText"
                                           Text="0 managed mods"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,5"/>

                                <TextBlock Text="Install approved community releases, or test a local DLL."
                                           FontSize="13"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"/>

                                <WrapPanel Margin="0,17,0,0">
                                    <Button Content="Import local DLL"
                                            Click="ImportLocal_Click"
                                            Style="{StaticResource PillButton}"
                                            Margin="0,0,8,8"/>

                                    <Button Content="Open logs"
                                            Click="OpenLogs_Click"
                                            Style="{StaticResource PillButton}"
                                            Margin="0,0,0,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Launch -->
                    <Border Style="{StaticResource PanelCard}"
                            Margin="0,11,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ready to play?"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Launch the selected OrbusVR installation."
                                           FontSize="13"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="▶  Launch OrbusVR"
                                    Click="Launch_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="12,0,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>


            <!-- SERVER CATALOGUE -->
            <Grid Grid.Row="1" x:Name="ServerPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ServerSearchText" VerticalContentAlignment="Center"
                             ToolTip="Search server mods"
                             TextChanged="ServerSearchText_Changed"/>
                    <Button Grid.Column="1" Content="Refresh" Click="RefreshCatalog_Click"
                            Style="{StaticResource PillButton}" Margin="10,0,0,0"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,3,0">
                        <Border Style="{StaticResource PanelCard}" Padding="15" Margin="0,0,0,13">
                            <StackPanel>
                                <TextBlock Text="For server operators" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Server mods belong on a game server, not inside your local OrbusVR instance."
                                           Foreground="{StaticResource MutedBrush}" FontSize="13"
                                           TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding ServerMods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="18"/>
                                                <TextBlock Text="{Binding Author}" FontSize="12"
                                                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                                                <TextBlock Text="{Binding Description}" FontSize="13"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextWrapping="Wrap" Margin="0,9,0,0"/>
                                                <TextBlock Text="{Binding Version}" FontSize="12"
                                                           Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="View source" Tag="{Binding}"
                                                    Style="{StaticResource PillButton}"
                                                    Click="OpenGithub_Click" Margin="16,0,0,0"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border x:Name="EmptyServerPanel" Style="{StaticResource PanelCard}"
                                Padding="36" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="No server mods found" FontSize="16"
                                           FontWeight="SemiBold" TextAlignment="Center"/>
                                <TextBlock Text="Server projects appear here when they're added to the community catalogue."
                                           FontSize="13" Foreground="{StaticResource MutedBrush}"
                                           Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- BROWSE MODS -->
            <Grid Grid.Row="1"
                  x:Name="DiscoverPanel"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchText"
                             ToolTip="Search mods"
                             TextChanged="SearchText_Changed"
                             VerticalContentAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="Check updates"
                            Click="CheckUpdates_Click"
                            Style="{StaticResource PillButton}"
                            Margin="10,0,0,0"/>

                    <Button Grid.Column="2"
                            Content="Refresh"
                            Click="RefreshCatalog_Click"
                            Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,3,0">
                        <Border Background="{StaticResource CardBrush}"
                                CornerRadius="14"
                                Padding="12"
                                Margin="0,0,0,12">
                            <TextBlock x:Name="CatalogInfo"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="13"
                                       Text="Approved community mods"/>
                        </Border>

                        <ItemsControl ItemsSource="{Binding DiscoverMods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PanelCard}"
                                            Margin="0,0,0,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                           FontWeight="Bold"
                                                           FontSize="18"/>

                                                <!-- Crash fix:
                                                     Run.Text can default to a
                                                     two-way binding. Author
                                                     is a read-only property,
                                                     so bind explicitly OneWay. -->
                                                <TextBlock Foreground="{StaticResource MutedBrush}"
                                                           FontSize="12"
                                                           Margin="0,6,0,0">
                                                    <Run Text="by "/>
                                                    <Run Text="{Binding Author, Mode=OneWay}"/>
                                                    <Run Text="  ·  "/>
                                                    <Run Text="{Binding Version, Mode=OneWay}"/>
                                                </TextBlock>

                                                <TextBlock Text="{Binding Description, Mode=OneWay}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextWrapping="Wrap"
                                                           FontSize="13"
                                                           Margin="0,10,0,0"/>

                                                <TextBlock Text="{Binding Status, Mode=OneWay}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="12"
                                                           Margin="0,10,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Margin="16,0,0,0"
                                                        VerticalAlignment="Center">
                                                <Button Content="{Binding Action, Mode=OneWay}"
                                                        Tag="{Binding}"
                                                        IsEnabled="{Binding CanClick, Mode=OneWay}"
                                                        Click="ModAction_Click"
                                                        Style="{StaticResource PrimaryButton}"
                                                        MinWidth="110"/>

                                                <Button Content="View on GitHub"
                                                        Tag="{Binding}"
                                                        Click="OpenGithub_Click"
                                                        Style="{StaticResource PillButton}"
                                                        Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty catalogue -->
                        <Border x:Name="EmptyCatalogText"
                                Style="{StaticResource PanelCard}"
                                Padding="38">
                            <StackPanel HorizontalAlignment="Center"
                                        MaxWidth="400">
                                <TextBlock Text="No mods published yet"
                                           FontWeight="Bold"
                                           FontSize="20"
                                           TextAlignment="Center"/>

                                <TextBlock Text="Approved community mods will appear here automatically."
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,10,0,0"
                                           FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Selected instance: a compact launcher header and a full-width,
                 aligned mod table. No redundant title or giant cards. -->
            <Grid Grid.Row="1" x:Name="InstalledPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,13">
                    <Button Content="←  Library" Click="Instances_Click"
                            Style="{StaticResource PillButton}"
                            HorizontalAlignment="Left"
                            Padding="9,5" MinHeight="27"
                            FontSize="12" Margin="0,0,0,17"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="61" Height="61" CornerRadius="13"
                                Background="#353947" VerticalAlignment="Center">
                            <ContentControl ContentTemplate="{StaticResource OrbusMark}"
                                            Width="47" Height="47"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="14,0,12,0">
                            <TextBlock x:Name="SelectedInstanceName"
                                       FontFamily="{StaticResource HeadingFont}"
                                       FontSize="23" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock x:Name="SelectedInstanceMeta"
                                           FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="    ·    " FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="SelectedInstanceLoaderText"
                                           FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="Open folder"
                                    Style="{StaticResource PillButton}"
                                    Click="SelectedOpenFolder_Click"
                                    MinHeight="36" Padding="12,8" Margin="0,0,9,0"/>
                            <Button Content="Plugins"
                                    Style="{StaticResource PillButton}"
                                    Click="SelectedOpenModsFolder_Click"
                                    MinHeight="36" Padding="12,8" Margin="0,0,9,0"/>
                            <Button x:Name="SelectedLoaderButton"
                                    Content="Install BepInEx"
                                    Style="{StaticResource PillButton}"
                                    Click="InstallLoader_Click"
                                    Visibility="Collapsed"
                                    MinHeight="36" Padding="12,8" Margin="0,0,9,0"/>
                            <Button Content="▶  Play" Click="Launch_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="99" MinHeight="39"
                                    Padding="14,8"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="SelectedInstancePathText" Visibility="Collapsed"/>
                    <TextBlock x:Name="SelectedInstanceWarning"
                               FontSize="12" Foreground="#F0C79C"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <Border Grid.Row="1" Height="1"
                        Background="{StaticResource StrokeBrush}"
                        Margin="0,6,0,19"/>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- One toolbar: title and install actions -->
                    <Grid Grid.Row="0" Margin="0,0,0,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Mods" FontSize="18" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="InstalledCountLabel"
                                       FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="Import DLL" Click="ImportLocal_Click"
                                    Style="{StaticResource PillButton}"
                                    MinHeight="35" Padding="11,7" Margin="0,0,8,0"/>
                            <Button Content="+  Browse mods" Click="Discover_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    MinHeight="35" Padding="12,7"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Margin="0,0,10,0">
                            <TextBox x:Name="InstalledSearchText"
                                     TextChanged="InstalledSearch_Changed"
                                     Padding="35,8,12,8" MinHeight="38"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock Text="⌕" FontSize="21"
                                       Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       IsHitTestVisible="False"/>
                            <TextBlock x:Name="InstalledSearchHint"
                                       Text="Search installed mods"
                                       FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="35,0,0,0"
                                       IsHitTestVisible="False"/>
                        </Grid>
                        <Button Grid.Column="1" Content="Check for updates"
                                Style="{StaticResource PillButton}"
                                Click="SelectedCheckModUpdates_Click"
                                MinHeight="38" Padding="12,8"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="FilterAllButton" Content="All" Tag="all"
                                    Click="InstalledFilter_Click"
                                    Style="{StaticResource PillButton}"
                                    MinHeight="30" Padding="12,6" Margin="0,0,6,0"/>
                            <Button x:Name="FilterEnabledButton" Content="Enabled" Tag="enabled"
                                    Click="InstalledFilter_Click"
                                    Style="{StaticResource PillButton}"
                                    MinHeight="30" Padding="12,6" Margin="0,0,6,0"/>
                            <Button x:Name="FilterDisabledButton" Content="Disabled" Tag="disabled"
                                    Click="InstalledFilter_Click"
                                    Style="{StaticResource PillButton}"
                                    MinHeight="30" Padding="12,6" Margin="0,0,6,0"/>
                            <Button x:Name="FilterUpdatesButton" Content="Updates" Tag="updates"
                                    Click="InstalledFilter_Click"
                                    Style="{StaticResource PillButton}"
                                    MinHeight="30" Padding="12,6"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="Only manager-installed mods appear here"
                                   FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Entire list is one surface, with unobtrusive row separators -->
                    <Border Grid.Row="3" Background="Transparent"
                            BorderThickness="0" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="41"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#292A32"
                                    CornerRadius="10,10,0,0"
                                    BorderBrush="{StaticResource StrokeBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="15,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="215"/>
                                        <ColumnDefinition Width="176"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="MOD" FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="VERSION"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="ACTIONS"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" Focusable="False"
                                          FocusVisualStyle="{x:Null}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding InstalledMods}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#22232A" Padding="15,10"
                                                        BorderBrush="{StaticResource StrokeBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        MinHeight="65">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="215"/>
                                                            <ColumnDefinition Width="176"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <Border Background="{Binding IconBrush}"
                                                                    Width="43" Height="43"
                                                                    CornerRadius="10"
                                                                    Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding IconLetter, Mode=OneWay}"
                                                                           FontSize="20"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="White"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                                           FontSize="14" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <StackPanel Orientation="Horizontal"
                                                                            Margin="0,4,0,0">
                                                                    <TextBlock Text="{Binding Author, Mode=OneWay}"
                                                                               Foreground="{StaticResource MutedBrush}"
                                                                               FontSize="12"/>
                                                                    <TextBlock Text="   ·   " FontSize="12"
                                                                               Foreground="{StaticResource MutedBrush}"/>
                                                                    <TextBlock Text="{Binding Status, Mode=OneWay}"
                                                                               FontSize="12"
                                                                               Foreground="{Binding StatusBrush}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                                    Margin="8,0,5,0">
                                                            <TextBlock Text="{Binding Version, Mode=OneWay}"
                                                                       FontSize="13" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding AssetDisplay, Mode=OneWay}"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       FontSize="11"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,4,0,0"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center">
                                                            <Button Content="Update" Tag="{Binding}"
                                                                    Click="InstalledUpdate_Click"
                                                                    Margin="0,0,9,0" MinHeight="30"
                                                                    Padding="9,5">
                                                                <Button.Style>
                                                                    <Style TargetType="Button"
                                                                           BasedOn="{StaticResource PrimaryButton}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding CanUpdate}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <Button Tag="{Binding}" Click="InstalledToggle_Click"
                                                                    Style="{StaticResource ModSwitchButton}"
                                                                    IsEnabled="{Binding CanModify}"
                                                                    Margin="0,0,12,0"/>
                                                            <Button Tag="{Binding}"
                                                                    Click="InstalledUninstall_Click"
                                                                    Style="{StaticResource ModIconActionButton}"
                                                                    ToolTip="Remove this mod">
                                                                <Viewbox Width="16" Height="16" Stretch="Uniform">
                                                                    <Canvas Width="20" Height="20">
                                                                        <Path Data="M 4,6 L 16,6 M 7,6 L 7.7,17 L 12.3,17 L 13,6 M 8,4 L 12,4"
                                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                              StrokeThickness="1.7"
                                                                              StrokeStartLineCap="Round"
                                                                              StrokeEndLineCap="Round"
                                                                              StrokeLineJoin="Round"
                                                                              Fill="Transparent"/>
                                                                    </Canvas>
                                                                </Viewbox>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border x:Name="EmptyInstalledText" Background="Transparent"
                                            Padding="35,36">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="No mods installed yet"
                                                       FontSize="17" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Find approved client mods or import your own DLL."
                                                       FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Margin="0,7,0,16" TextAlignment="Center"/>
                                            <Button Content="Browse mods"
                                                    Click="Discover_Click"
                                                    HorizontalAlignment="Center"
                                                    Style="{StaticResource PrimaryButton}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="NoMatchingInstalledText"
                                            Background="Transparent" Padding="33"
                                            Visibility="Collapsed">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="No matching mods"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                            <Button Content="Clear search and filters"
                                                    Margin="0,13,0,0"
                                                    Style="{StaticResource PillButton}"
                                                    Click="InstalledClearFilters_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="SelectedModSummary" Visibility="Collapsed"/>
                </Grid>
            </Grid>

            <!-- SETTINGS -->
            <ScrollViewer Grid.Row="1"
                          x:Name="SettingsPanel"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,3,0">
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,11">
                        <StackPanel>
                            <TextBlock Text="STORAGE" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="Instance location" FontSize="17"
                                       FontWeight="SemiBold" Margin="0,10,0,7"/>
                            <TextBlock Text="New game copies are saved here by default."
                                       FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="DefaultInstanceFolderText" FontSize="13"
                                       TextWrapping="Wrap" Margin="0,12,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Change location"
                                        Click="ChangeInstanceStorage_Click"
                                        Style="{StaticResource PillButton}"/>
                                <Button Content="Open folder" Margin="8,0,0,0"
                                        Click="OpenInstanceStorage_Click"
                                        Style="{StaticResource PillButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,11">
                        <StackPanel>
                            <TextBlock Text="FIRST-TIME SETUP" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="Try the welcome experience"
                                       FontSize="17" FontWeight="SemiBold" Margin="0,9,0,7"/>
                            <TextBlock Text="Preview what a new player sees when selecting their game and creating their first instance. This preview does not change your settings or copy any game files."
                                       FontSize="13" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,13"/>
                            <Button Content="Preview first-launch setup"
                                    Style="{StaticResource PillButton}"
                                    Click="PreviewFirstRun_Click"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="APPLICATION" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="RebornManager updates" FontSize="17"
                                       FontWeight="SemiBold" Margin="0,10,0,8"/>
                            <TextBlock x:Name="ManagerVersionText" FontSize="13"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="ManagerUpdateStatusText" FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,9,0,0"/>
                            <ProgressBar x:Name="ManagerUpdateProgress" Height="6" Maximum="100"
                                         Foreground="{StaticResource AccentBrush}"
                                         Visibility="Collapsed" Margin="0,13,0,0"/>
                            <CheckBox x:Name="CheckManagerUpdatesCheck"
                                      Content="Check for RebornManager updates when the app opens"
                                      Margin="0,17,0,13"/>
                            <Button x:Name="CheckManagerUpdatesButton"
                                    Content="Check for updates" Click="CheckManagerUpdates_Click"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource PillButton}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="MOD UPDATES"
                                       Style="{StaticResource Eyebrow}"/>

                            <TextBlock Text="Keep your mods up to date"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,8"/>

                            <TextBlock Text="The manager checks approved mods on GitHub when you open it."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>

                            <CheckBox x:Name="AutoUpdatesCheck"
                                      Margin="0,19,0,17"
                                      Content="Install available mod updates automatically while OrbusVR is closed"/>

                            <Button Content="Save settings"
                                    Click="SaveSettings_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="WANT TO SUBMIT A MOD?"
                                       Style="{StaticResource Eyebrow}"/>

                            <TextBlock Text="Contact the maintainer"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,9,0,7"/>

                            <TextBlock Text="Send your GitHub repository to the maintainer on Discord. Approved mods are added to the catalogue for everyone."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- App installation management -->
                    <Border Style="{StaticResource PanelCard}" Margin="0,11,0,0">
                        <StackPanel>
                            <TextBlock Text="INSTALLATION" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="Remove RebornManager" FontSize="16"
                                       FontWeight="SemiBold" Margin="0,10,0,8"/>
                            <TextBlock Text="Uninstall the app while keeping your OrbusVR instances and settings."
                                       FontSize="13" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <Button x:Name="UninstallManagerButton"
                                    Content="Uninstall RebornManager"
                                    Click="UninstallManager_Click"
                                    IsEnabled="False"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource PillButton}"
                                    Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Legacy controller fields, hidden from users -->
                    <StackPanel Visibility="Collapsed">
                        <TextBox x:Name="CatalogUrlText"/>
                        <TextBox x:Name="NewRepoText"/>
                        <TextBox x:Name="NewNameText"/>
                        <TextBox x:Name="NewAssetText"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- STATUS BAR -->
            <Border Grid.Row="2"
                    Background="Transparent"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="0,10,0,0"
                    Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="UpdateActionButton" Grid.Column="1"
                            Content="Update &amp; restart"
                            Click="UpdateAction_Click"
                            Style="{StaticResource PrimaryButton}"
                            Visibility="Collapsed"
                            Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusLine"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Text="Ready"
                               TextTrimming="CharacterEllipsis"/>

                    <ProgressBar x:Name="ActivityBar"
                                 Grid.Column="2"
                                 Width="85"
                                 Height="5"
                                 Foreground="{StaticResource AccentBrush}"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 Margin="12,0,0,0"
                                 VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </Grid>
</Window>
