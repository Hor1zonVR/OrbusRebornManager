
<Window x:Class="OrbusRebornManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbus Reborn Manager"
        Width="1210" Height="810"
        MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        Background="#0A0F19"
        Foreground="#F2F7FC"
        FontFamily="Segoe UI">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- Navigation -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,25,16,19">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,38">
                        <Border Width="43" Height="43" CornerRadius="12"
                                Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                            <TextBlock Text="O" FontSize="27" FontWeight="Black"
                                       Foreground="#082A2C" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ORBUS REBORN" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="MOD MANAGER" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" FontSize="10"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="LIBRARY" Style="{StaticResource Eyebrow}"
                               Margin="13,0,0,11"/>
                    <Button x:Name="NavHome" Style="{StaticResource SidebarButton}"
                            Click="Instances_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="18" Margin="0,0,15,0"/>
                            <TextBlock Text="My Instances" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavBrowse" Style="{StaticResource SidebarButton}"
                            Click="Discover_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="18" Margin="0,0,15,0"/>
                            <TextBlock Text="Client Mods" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavServer" Style="{StaticResource SidebarButton}"
                            Click="ServerMods_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="18" Margin="0,0,15,0"/>
                            <TextBlock Text="Server Mods" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Height="1" Background="{StaticResource StrokeBrush}"
                            Margin="10,21,10,17"/>
                    <Button x:Name="NavSettings" Style="{StaticResource SidebarButton}"
                            Click="SimpleSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="18" Margin="0,0,15,0"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="REBORN COMMUNITY EDITION" FontSize="10"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="v0.4.1 development preview" FontSize="10"
                               HorizontalAlignment="Center" Foreground="#778BA0"
                               Margin="0,7,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1"
              Margin="32,28,32,21">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Page heading -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,23">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="PageHeading"
                               Text="Home"
                               FontSize="29"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="PageSubtitle"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Button x:Name="HeaderCreateButton" Grid.Column="1"
                        Content="+  New Instance" Click="CreateInstance_Click"
                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"/>
                <Border x:Name="HeaderStatusCard" Grid.Column="1"
                        Background="#15332F"
                        CornerRadius="20"
                        BorderBrush="#2A554F"
                        BorderThickness="1"
                        Padding="14,8"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                    <TextBlock x:Name="TopStatus"
                               Text="●  Select a game"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"/>
                </Border>
            </Grid>


            <!-- INSTANCES -->
            <ScrollViewer Grid.Row="1" x:Name="InstancesPanel"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,3,4">
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="YOUR LIBRARY" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="Choose an instance to play or manage its mods."
                                       FontSize="13" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Add existing game"
                                Style="{StaticResource PillButton}"
                                Click="OpenInstances_Click" VerticalAlignment="Center"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding InstanceCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="285" MinHeight="214" Margin="0,0,14,14"
                                        Tag="{Binding}" ToolTip="Open instance"
                                        Cursor="Hand" MouseLeftButtonUp="InstanceCard_Click"
                                        Padding="19" CornerRadius="14" BorderThickness="1"
                                        Background="{StaticResource CardBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="#6A8A91"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu Style="{StaticResource InstanceContextMenu}"
                                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Style="{StaticResource InstanceMenuItem}"
                                                      Header="Play" Tag="{Binding}" Click="InstancePlay_Click"/>
                                            <MenuItem Style="{StaticResource InstanceMenuItem}"
                                                      Header="View instance" Tag="{Binding}" Click="InstanceManage_Click"/>
                                            <MenuItem Style="{StaticResource InstanceMenuItem}"
                                                      Header="Open folder" Tag="{Binding}" Click="InstanceOpenFolder_Click"/>
                                            <MenuItem Style="{StaticResource InstanceMenuItem}"
                                                      Header="Copy folder path" Tag="{Binding}" Click="InstanceCopyPath_Click"/>
                                            <MenuItem Style="{StaticResource InstanceMenuItem}"
                                                      Header="Remove from list" Tag="{Binding}" Click="InstanceForget_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="48" Height="48" CornerRadius="12"
                                                    Background="{StaticResource CardAltBrush}"
                                                    Margin="0,0,13,0">
                                                <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="23" Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Width="178">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Kind}" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Margin="0,19,0,16">
                                            <TextBlock Text="{Binding ModCount}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Readiness}" FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap" Margin="0,7,0,0"/>
                                        </StackPanel>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Content="Play" Tag="{Binding}"
                                                    Click="InstancePlay_Click"
                                                    Style="{StaticResource PrimaryButton}" Margin="0,0,5,0"/>
                                            <Button Grid.Column="1" Content="Manage" Tag="{Binding}"
                                                    Click="InstanceManage_Click"
                                                    Style="{StaticResource PillButton}" Margin="5,0,0,0"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border x:Name="EmptyInstancesPanel" Style="{StaticResource PanelCard}"
                            Padding="40" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="430">
                            <TextBlock Text="Your adventure starts here" FontSize="22"
                                       FontWeight="Bold" TextAlignment="Center"/>
                            <TextBlock Text="Add your OrbusVR installation, then make a separate copy for mods."
                                       FontSize="13" Foreground="{StaticResource MutedBrush}"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,11,0,20"/>
                            <Button Content="Add OrbusVR installation"
                                    HorizontalAlignment="Center" Click="OpenInstances_Click"
                                    Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- INSTANCE DETAILS -->
            <ScrollViewer Grid.Row="1"
                          x:Name="DashboardPanel"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,3,2">

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="CURRENT GAME"
                                       Style="{StaticResource Eyebrow}"/>

                            <TextBlock Text="Manage this installation"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,9,0,7"/>

                            <TextBlock Text="Manage the mod loader and installed mods for this game copy."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                            <TextBox x:Name="GamePathText"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     Margin="0,15,0,0"/>

                            <WrapPanel Margin="0,13,0,0">
                                <Button Content="Back to instances"
                                        Click="OpenInstances_Click"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,9,8"/>

                                <Button Content="+ Create a clean copy"
                                        Click="CreateInstance_Click"
                                        Style="{StaticResource PillButton}"
                                        Margin="0,0,0,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- BepInEx -->
                        <Border Grid.Column="0"
                                Style="{StaticResource PanelCard}"
                                Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="MOD LOADER"
                                           Style="{StaticResource Eyebrow}"/>

                                <TextBlock x:Name="LoaderStatusText"
                                           Text="Select a game"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="0,12,0,5"/>

                                <TextBlock Text="BepInEx, installed separately for each game copy."
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"/>

                                <Button x:Name="InstallLoaderButton"
                                        Content="Install BepInEx"
                                        Click="InstallLoader_Click"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,17,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Mod collection -->
                        <Border Grid.Column="1"
                                Style="{StaticResource PanelCard}"
                                Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="YOUR MODS"
                                           Style="{StaticResource Eyebrow}"/>

                                <TextBlock x:Name="ModsCountText"
                                           Text="0 managed mods"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="0,12,0,5"/>

                                <TextBlock Text="Install approved community releases, or test a local DLL."
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"/>

                                <WrapPanel Margin="0,17,0,0">
                                    <Button Content="Import local DLL"
                                            Click="ImportLocal_Click"
                                            Style="{StaticResource PillButton}"
                                            Margin="0,0,8,8"/>

                                    <Button Content="Open logs"
                                            Click="OpenLogs_Click"
                                            Style="{StaticResource PillButton}"
                                            Margin="0,0,0,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Launch -->
                    <Border Style="{StaticResource PanelCard}"
                            Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ready to play?"
                                           FontSize="18"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Launch the selected OrbusVR installation."
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="▶  Launch OrbusVR"
                                    Click="Launch_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="12,0,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>


            <!-- SERVER CATALOGUE -->
            <Grid Grid.Row="1" x:Name="ServerPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ServerSearchText" VerticalContentAlignment="Center"
                             ToolTip="Search server mods"
                             TextChanged="ServerSearchText_Changed"/>
                    <Button Grid.Column="1" Content="Refresh" Click="RefreshCatalog_Click"
                            Style="{StaticResource PillButton}" Margin="10,0,0,0"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,3,0">
                        <Border Style="{StaticResource PanelCard}" Padding="15" Margin="0,0,0,13">
                            <StackPanel>
                                <TextBlock Text="For server operators" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Server mods belong on a game server, not inside your local OrbusVR instance."
                                           Foreground="{StaticResource MutedBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding ServerMods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="18"/>
                                                <TextBlock Text="{Binding Author}" FontSize="11"
                                                           Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextWrapping="Wrap" Margin="0,9,0,0"/>
                                                <TextBlock Text="{Binding Version}" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="View source" Tag="{Binding}"
                                                    Style="{StaticResource PillButton}"
                                                    Click="OpenGithub_Click" Margin="16,0,0,0"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border x:Name="EmptyServerPanel" Style="{StaticResource PanelCard}"
                                Padding="36" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="No server mods found" FontSize="19"
                                           FontWeight="Bold" TextAlignment="Center"/>
                                <TextBlock Text="Server projects appear here when they're added to the community catalogue."
                                           FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- BROWSE MODS -->
            <Grid Grid.Row="1"
                  x:Name="DiscoverPanel"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchText"
                             ToolTip="Search mods"
                             TextChanged="SearchText_Changed"
                             VerticalContentAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="Check updates"
                            Click="CheckUpdates_Click"
                            Style="{StaticResource PillButton}"
                            Margin="10,0,0,0"/>

                    <Button Grid.Column="2"
                            Content="Refresh"
                            Click="RefreshCatalog_Click"
                            Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,3,0">
                        <Border Background="#16322F"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,0,0,12">
                            <TextBlock x:Name="CatalogInfo"
                                       Foreground="#C3E7E0"
                                       FontSize="12"
                                       Text="Approved community mods"/>
                        </Border>

                        <ItemsControl ItemsSource="{Binding DiscoverMods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PanelCard}"
                                            Margin="0,0,0,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                           FontWeight="Bold"
                                                           FontSize="18"/>

                                                <!-- Crash fix:
                                                     Run.Text can default to a
                                                     two-way binding. Author
                                                     is a read-only property,
                                                     so bind explicitly OneWay. -->
                                                <TextBlock Foreground="{StaticResource AccentBrush}"
                                                           FontSize="11"
                                                           Margin="0,6,0,0">
                                                    <Run Text="by "/>
                                                    <Run Text="{Binding Author, Mode=OneWay}"/>
                                                    <Run Text="  ·  "/>
                                                    <Run Text="{Binding Version, Mode=OneWay}"/>
                                                </TextBlock>

                                                <TextBlock Text="{Binding Description, Mode=OneWay}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           Margin="0,10,0,0"/>

                                                <TextBlock Text="{Binding Status, Mode=OneWay}"
                                                           Foreground="#C3D5E5"
                                                           FontSize="11"
                                                           Margin="0,10,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Margin="16,0,0,0"
                                                        VerticalAlignment="Center">
                                                <Button Content="{Binding Action, Mode=OneWay}"
                                                        Tag="{Binding}"
                                                        IsEnabled="{Binding CanClick, Mode=OneWay}"
                                                        Click="ModAction_Click"
                                                        Style="{StaticResource PrimaryButton}"
                                                        MinWidth="110"/>

                                                <Button Content="View on GitHub"
                                                        Tag="{Binding}"
                                                        Click="OpenGithub_Click"
                                                        Style="{StaticResource PillButton}"
                                                        Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty catalogue -->
                        <Border x:Name="EmptyCatalogText"
                                Style="{StaticResource PanelCard}"
                                Padding="38">
                            <StackPanel HorizontalAlignment="Center"
                                        MaxWidth="400">
                                <TextBlock Text="No mods published yet"
                                           FontWeight="Bold"
                                           FontSize="20"
                                           TextAlignment="Center"/>

                                <TextBlock Text="Approved community mods will appear here automatically."
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,10,0,0"
                                           FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- MY MODS -->
            <Grid Grid.Row="1"
                  x:Name="InstalledPanel"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="#16322F"
                        Padding="14"
                        CornerRadius="10"
                        Margin="0,0,0,12">
                    <TextBlock Text="Mods are managed separately for each installation. Close the game before making changes."
                               Foreground="#C3E7E0"
                               TextWrapping="Wrap"
                               FontSize="12"/>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,3,0">
                        <ItemsControl ItemsSource="{Binding InstalledMods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PanelCard}"
                                            Margin="0,0,0,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                           FontSize="18"
                                                           FontWeight="Bold"/>

                                                <TextBlock Text="{Binding Version, Mode=OneWay}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           Margin="0,6,0,0"/>

                                                <TextBlock Text="{Binding Status, Mode=OneWay}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           Margin="0,10,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Margin="15,0,0,0"
                                                        VerticalAlignment="Center">
                                                <Button Content="{Binding Action, Mode=OneWay}"
                                                        Tag="{Binding}"
                                                        IsEnabled="{Binding CanClick, Mode=OneWay}"
                                                        Click="InstalledToggle_Click"
                                                        Style="{StaticResource PrimaryButton}"/>

                                                <Button Content="Uninstall"
                                                        Tag="{Binding}"
                                                        IsEnabled="{Binding CanClick, Mode=OneWay}"
                                                        Click="InstalledUninstall_Click"
                                                        Style="{StaticResource PillButton}"
                                                        Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border x:Name="EmptyInstalledText"
                                Style="{StaticResource PanelCard}"
                                Padding="38">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="No managed mods on this instance"
                                           FontWeight="Bold"
                                           FontSize="19"
                                           TextAlignment="Center"/>

                                <TextBlock Text="Choose Browse mods, or import a local test DLL from Home."
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,10,0,0"
                                           FontSize="12"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- SETTINGS -->
            <ScrollViewer Grid.Row="1"
                          x:Name="SettingsPanel"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,3,0">
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="APPLICATION" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="RebornManager updates" FontSize="21"
                                       FontWeight="Bold" Margin="0,10,0,8"/>
                            <TextBlock x:Name="ManagerVersionText" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="ManagerUpdateStatusText" FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,9,0,0"/>
                            <ProgressBar x:Name="ManagerUpdateProgress" Height="6" Maximum="100"
                                         Foreground="{StaticResource AccentBrush}"
                                         Visibility="Collapsed" Margin="0,13,0,0"/>
                            <CheckBox x:Name="CheckManagerUpdatesCheck"
                                      Content="Check for RebornManager updates when the app opens"
                                      Margin="0,17,0,13"/>
                            <Button x:Name="CheckManagerUpdatesButton"
                                    Content="Check for updates" Click="CheckManagerUpdates_Click"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource PillButton}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="MOD UPDATES"
                                       Style="{StaticResource Eyebrow}"/>

                            <TextBlock Text="Keep your mods up to date"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       Margin="0,10,0,8"/>

                            <TextBlock Text="The manager checks approved mods on GitHub when you open it."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                            <CheckBox x:Name="AutoUpdatesCheck"
                                      Margin="0,19,0,17"
                                      Content="Install available mod updates automatically while OrbusVR is closed"/>

                            <Button Content="Save settings"
                                    Click="SaveSettings_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="WANT TO SUBMIT A MOD?"
                                       Style="{StaticResource Eyebrow}"/>

                            <TextBlock Text="Contact the maintainer"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,9,0,7"/>

                            <TextBlock Text="Send your GitHub repository to the maintainer on Discord. Approved mods are added to the catalogue for everyone."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- App installation management -->
                    <Border Style="{StaticResource PanelCard}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="INSTALLATION" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="Remove RebornManager" FontSize="19"
                                       FontWeight="Bold" Margin="0,10,0,8"/>
                            <TextBlock Text="Uninstall the app while keeping your OrbusVR instances and settings."
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <Button x:Name="UninstallManagerButton"
                                    Content="Uninstall RebornManager"
                                    Click="UninstallManager_Click"
                                    IsEnabled="False"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource PillButton}"
                                    Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Legacy controller fields, hidden from users -->
                    <StackPanel Visibility="Collapsed">
                        <TextBox x:Name="CatalogUrlText"/>
                        <TextBox x:Name="NewRepoText"/>
                        <TextBox x:Name="NewNameText"/>
                        <TextBox x:Name="NewAssetText"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- STATUS BAR -->
            <Border Grid.Row="2"
                    Background="#142132"
                    CornerRadius="10"
                    Padding="14,11"
                    Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="UpdateActionButton" Grid.Column="1"
                            Content="Update &amp; restart"
                            Click="UpdateAction_Click"
                            Style="{StaticResource PrimaryButton}"
                            Visibility="Collapsed"
                            Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusLine"
                               Foreground="#B6CADC"
                               FontSize="11"
                               Text="Ready"
                               TextTrimming="CharacterEllipsis"/>

                    <ProgressBar x:Name="ActivityBar"
                                 Grid.Column="1"
                                 Width="85"
                                 Height="5"
                                 Foreground="{StaticResource AccentBrush}"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 Margin="12,0,0,0"
                                 VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
