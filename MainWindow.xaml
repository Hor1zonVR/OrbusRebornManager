
<Window x:Class="OrbusRebornManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbus Reborn Manager"
        Width="1210" Height="810"
        MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        Background="#0A0F19"
        Foreground="#F2F7FC"
        FontFamily="Segoe UI">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="#29394D"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="16,26,16,19">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal"
                                Margin="8,0,0,38">
                        <Border Width="42"
                                Height="42"
                                CornerRadius="12"
                                Background="{StaticResource AccentBrush}"
                                Margin="0,0,11,0">
                            <TextBlock Text="O"
                                       FontSize="27"
                                       FontWeight="Black"
                                       Foreground="#082A2C"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ORBUS"
                                       FontSize="20"
                                       FontWeight="Bold"/>
                            <TextBlock Text="REBORN MANAGER"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="9"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="LIBRARY"
                               Margin="12,0,0,11"
                               FontWeight="Bold"
                               Foreground="#8196AF"
                               FontSize="10"/>

                    <Button x:Name="NavHome"
                            Content="⌂     Home"
                            Click="Dashboard_Click"
                            Style="{StaticResource SidebarButton}"/>

                    <Button x:Name="NavBrowse"
                            Content="▦     Browse mods"
                            Click="Discover_Click"
                            Style="{StaticResource SidebarButton}"/>

                    <Button x:Name="NavInstalled"
                            Content="▤     My mods"
                            Click="Installed_Click"
                            Style="{StaticResource SidebarButton}"/>

                    <Border Height="1"
                            Background="#263548"
                            Margin="10,22,10,20"/>

                    <Button x:Name="NavSettings"
                            Content="⚙     Settings"
                            Click="SimpleSettings_Click"
                            Style="{StaticResource SidebarButton}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom"
                            VerticalAlignment="Bottom">
                    <Border Background="#17283A"
                            CornerRadius="11"
                            Padding="13"
                            Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="●   REBORN COMMUNITY EDITION"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>

                            <TextBlock Text="Windows PC · IL2CPP"
                                       FontSize="11"
                                       Foreground="#A5BBCE"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="Classic / Preborn not supported"
                                       FontSize="10"
                                       Foreground="#7D96AE"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ORBUS REBORN MANAGER  ·  V0.3.1"
                               FontSize="9"
                               Foreground="#778BA0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1"
              Margin="32,28,32,21">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Page heading -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,23">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="PageHeading"
                               Text="Home"
                               FontSize="29"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="PageSubtitle"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#15332F"
                        CornerRadius="20"
                        BorderBrush="#2A554F"
                        BorderThickness="1"
                        Padding="14,8"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                    <TextBlock x:Name="TopStatus"
                               Text="●  Select a game"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"/>
                </Border>
            </Grid>

            <!-- HOME -->
            <ScrollViewer Grid.Row="1"
                          x:Name="DashboardPanel"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,3,2">

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="CURRENT GAME"
                                       Style="{StaticResource Eyebrow}"/>

                            <TextBlock Text="Choose where you want to play"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,9,0,7"/>

                            <TextBlock Text="Play your original game, or make a separate copy for safe mod testing."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                            <TextBox x:Name="GamePathText"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     Margin="0,15,0,0"/>

                            <WrapPanel Margin="0,13,0,0">
                                <Button Content="Manage installations"
                                        Click="OpenInstances_Click"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,9,8"/>

                                <Button Content="+ Create a clean copy"
                                        Click="CreateInstance_Click"
                                        Style="{StaticResource PillButton}"
                                        Margin="0,0,0,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- BepInEx -->
                        <Border Grid.Column="0"
                                Style="{StaticResource PanelCard}"
                                Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="MOD LOADER"
                                           Style="{StaticResource Eyebrow}"/>

                                <TextBlock x:Name="LoaderStatusText"
                                           Text="Select a game"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="0,12,0,5"/>

                                <TextBlock Text="BepInEx, installed separately for each game copy."
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"/>

                                <Button x:Name="InstallLoaderButton"
                                        Content="Install BepInEx"
                                        Click="InstallLoader_Click"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,17,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Mod collection -->
                        <Border Grid.Column="1"
                                Style="{StaticResource PanelCard}"
                                Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="YOUR MODS"
                                           Style="{StaticResource Eyebrow}"/>

                                <TextBlock x:Name="ModsCountText"
                                           Text="0 managed mods"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="0,12,0,5"/>

                                <TextBlock Text="Install approved community releases, or test a local DLL."
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"/>

                                <WrapPanel Margin="0,17,0,0">
                                    <Button Content="Import local DLL"
                                            Click="ImportLocal_Click"
                                            Style="{StaticResource PillButton}"
                                            Margin="0,0,8,8"/>

                                    <Button Content="Open logs"
                                            Click="OpenLogs_Click"
                                            Style="{StaticResource PillButton}"
                                            Margin="0,0,0,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Launch -->
                    <Border Style="{StaticResource PanelCard}"
                            Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ready to play?"
                                           FontSize="18"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Launch the selected OrbusVR installation."
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="▶  Launch OrbusVR"
                                    Click="Launch_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="12,0,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- BROWSE MODS -->
            <Grid Grid.Row="1"
                  x:Name="DiscoverPanel"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchText"
                             ToolTip="Search mods"
                             TextChanged="SearchText_Changed"
                             VerticalContentAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="Check updates"
                            Click="CheckUpdates_Click"
                            Style="{StaticResource PillButton}"
                            Margin="10,0,0,0"/>

                    <Button Grid.Column="2"
                            Content="Refresh"
                            Click="RefreshCatalog_Click"
                            Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,3,0">
                        <Border Background="#16322F"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,0,0,12">
                            <TextBlock x:Name="CatalogInfo"
                                       Foreground="#C3E7E0"
                                       FontSize="12"
                                       Text="Approved community mods"/>
                        </Border>

                        <ItemsControl ItemsSource="{Binding DiscoverMods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PanelCard}"
                                            Margin="0,0,0,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                           FontWeight="Bold"
                                                           FontSize="18"/>

                                                <!-- Crash fix:
                                                     Run.Text can default to a
                                                     two-way binding. Author
                                                     is a read-only property,
                                                     so bind explicitly OneWay. -->
                                                <TextBlock Foreground="{StaticResource AccentBrush}"
                                                           FontSize="11"
                                                           Margin="0,6,0,0">
                                                    <Run Text="by "/>
                                                    <Run Text="{Binding Author, Mode=OneWay}"/>
                                                    <Run Text="  ·  "/>
                                                    <Run Text="{Binding Version, Mode=OneWay}"/>
                                                </TextBlock>

                                                <TextBlock Text="{Binding Description, Mode=OneWay}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           Margin="0,10,0,0"/>

                                                <TextBlock Text="{Binding Status, Mode=OneWay}"
                                                           Foreground="#C3D5E5"
                                                           FontSize="11"
                                                           Margin="0,10,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Margin="16,0,0,0"
                                                        VerticalAlignment="Center">
                                                <Button Content="{Binding Action, Mode=OneWay}"
                                                        Tag="{Binding}"
                                                        IsEnabled="{Binding CanClick, Mode=OneWay}"
                                                        Click="ModAction_Click"
                                                        Style="{StaticResource PrimaryButton}"
                                                        MinWidth="110"/>

                                                <Button Content="View on GitHub"
                                                        Tag="{Binding}"
                                                        Click="OpenGithub_Click"
                                                        Style="{StaticResource PillButton}"
                                                        Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty catalogue -->
                        <Border x:Name="EmptyCatalogText"
                                Style="{StaticResource PanelCard}"
                                Padding="38">
                            <StackPanel HorizontalAlignment="Center"
                                        MaxWidth="400">
                                <TextBlock Text="No mods published yet"
                                           FontWeight="Bold"
                                           FontSize="20"
                                           TextAlignment="Center"/>

                                <TextBlock Text="Approved community mods will appear here automatically."
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,10,0,0"
                                           FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- MY MODS -->
            <Grid Grid.Row="1"
                  x:Name="InstalledPanel"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="#16322F"
                        Padding="14"
                        CornerRadius="10"
                        Margin="0,0,0,12">
                    <TextBlock Text="Mods are managed separately for each installation. Close the game before making changes."
                               Foreground="#C3E7E0"
                               TextWrapping="Wrap"
                               FontSize="12"/>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,3,0">
                        <ItemsControl ItemsSource="{Binding InstalledMods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PanelCard}"
                                            Margin="0,0,0,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                           FontSize="18"
                                                           FontWeight="Bold"/>

                                                <TextBlock Text="{Binding Version, Mode=OneWay}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           Margin="0,6,0,0"/>

                                                <TextBlock Text="{Binding Status, Mode=OneWay}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           Margin="0,10,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Margin="15,0,0,0"
                                                        VerticalAlignment="Center">
                                                <Button Content="{Binding Action, Mode=OneWay}"
                                                        Tag="{Binding}"
                                                        IsEnabled="{Binding CanClick, Mode=OneWay}"
                                                        Click="InstalledToggle_Click"
                                                        Style="{StaticResource PrimaryButton}"/>

                                                <Button Content="Uninstall"
                                                        Tag="{Binding}"
                                                        IsEnabled="{Binding CanClick, Mode=OneWay}"
                                                        Click="InstalledUninstall_Click"
                                                        Style="{StaticResource PillButton}"
                                                        Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border x:Name="EmptyInstalledText"
                                Style="{StaticResource PanelCard}"
                                Padding="38">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="No managed mods on this instance"
                                           FontWeight="Bold"
                                           FontSize="19"
                                           TextAlignment="Center"/>

                                <TextBlock Text="Choose Browse mods, or import a local test DLL from Home."
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,10,0,0"
                                           FontSize="12"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- SETTINGS -->
            <ScrollViewer Grid.Row="1"
                          x:Name="SettingsPanel"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,3,0">
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="MOD UPDATES"
                                       Style="{StaticResource Eyebrow}"/>

                            <TextBlock Text="Keep your mods up to date"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       Margin="0,10,0,8"/>

                            <TextBlock Text="The manager checks approved mods on GitHub when you open it."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                            <CheckBox x:Name="AutoUpdatesCheck"
                                      Margin="0,19,0,17"
                                      Content="Install available mod updates automatically while OrbusVR is closed"/>

                            <Button Content="Save settings"
                                    Click="SaveSettings_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="WANT TO SUBMIT A MOD?"
                                       Style="{StaticResource Eyebrow}"/>

                            <TextBlock Text="Contact the maintainer"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,9,0,7"/>

                            <TextBlock Text="Send your GitHub repository to the maintainer on Discord. Approved mods are added to the catalogue for everyone."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Legacy controller fields, hidden from users -->
                    <StackPanel Visibility="Collapsed">
                        <TextBox x:Name="CatalogUrlText"/>
                        <TextBox x:Name="NewRepoText"/>
                        <TextBox x:Name="NewNameText"/>
                        <TextBox x:Name="NewAssetText"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- STATUS BAR -->
            <Border Grid.Row="2"
                    Background="#142132"
                    CornerRadius="10"
                    Padding="14,11"
                    Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusLine"
                               Foreground="#B6CADC"
                               FontSize="11"
                               Text="Ready"
                               TextTrimming="CharacterEllipsis"/>

                    <ProgressBar x:Name="ActivityBar"
                                 Grid.Column="1"
                                 Width="85"
                                 Height="5"
                                 Foreground="{StaticResource AccentBrush}"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 Margin="12,0,0,0"
                                 VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
