
<Window x:Class="OrbusRebornManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="OrbusManager"
        Width="1210" Height="810"
        WindowStyle="None" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource InterfaceFont}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- A WPF-rendered title bar avoids the mismatched Windows frame. -->
        <Border Grid.Row="0" Background="#202127" BorderBrush="#373940"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="ChromeTitle_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0,0,0">
                    <ContentControl ContentTemplate="{StaticResource OrbusMark}"
                                    Width="27" Height="27"/>
                    <TextBlock Text="Orbus" FontFamily="{StaticResource HeadingFont}"
                               FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Text="Manager" FontSize="13" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" Margin="7,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="1">
                    <Button Style="{StaticResource ChromeButton}"
                            ToolTip="Minimize" Click="Chrome_Minimize_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}"
                            ToolTip="Maximize or restore" Click="Chrome_Maximize_Click">
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource CloseChromeButton}"
                            ToolTip="Close" Click="Chrome_Close_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="214"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Quiet sidebar: one clear action per row, settings anchored below. -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,20,12,16">
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="7,0,7,10"/>
                        <Button Style="{StaticResource SidebarButton}"
                                Click="SubmitMod_Click" ToolTip="Submit an OrbusVR mod for catalogue review">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Margin="0,0,13,0"/>
                                <TextBlock Text="Submit a mod" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavCommunity" Style="{StaticResource SidebarButton}"
                                Click="Community_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE902;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Margin="0,0,13,0"/>
                                <TextBlock Text="Community &amp; Help" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSettings" Style="{StaticResource SidebarButton}"
                                Click="SimpleSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Margin="0,0,13,0"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="SidebarVersionText" Text="OrbusManager"
                                   Foreground="{StaticResource MutedBrush}" FontSize="13"
                                   HorizontalAlignment="Left" Margin="12,10,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="LIBRARY" Style="{StaticResource Eyebrow}"
                                   Margin="12,2,0,14"/>
                        <Button x:Name="NavHome" Style="{StaticResource SidebarButton}"
                                Click="Instances_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Margin="0,0,13,0"/>
                                <TextBlock Text="My Instances" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavBrowse" Style="{StaticResource SidebarButton}"
                                Click="Discover_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Margin="0,0,13,0"/>
                                <TextBlock Text="Client Mods" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="SERVER" Style="{StaticResource Eyebrow}" Margin="12,23,0,11"/>
                        <Button x:Name="NavServers" Style="{StaticResource SidebarButton}"
                                Click="Servers_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Margin="0,0,13,0"/>
                                <TextBlock Text="My Servers" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavServer" Style="{StaticResource SidebarButton}"
                                Click="ServerMods_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Margin="0,0,13,0"/>
                                <TextBlock Text="Server Mods" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

        <!-- Main content -->
        <Grid Grid.Column="1"
              Margin="25,22,25,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Sparse, decorative Orbus-inspired sigils. These never accept input and
                 remain behind cards/controls; at 4–6% opacity they're atmosphere only. -->
            <!-- Traced from the player's real in-game rune pillar screenshots.
                 Transparent vectors replace the generic fantasy motif shapes. -->
            <Canvas Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True"
                    Opacity="0.07">
                <Viewbox Width="250" Height="230" Canvas.Right="-50" Canvas.Top="-15">
                    <Canvas Width="110" Height="110">
                        <Path Data="M 20,12 L 22,98 M 22,12 L 85,44 L 22,65 L 90,87"
                              Stroke="#8CD2B2" StrokeThickness="7"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Fill="Transparent"/>
                    </Canvas>
                </Viewbox>
                <Viewbox Width="180" Height="170" Canvas.Left="35" Canvas.Bottom="-35">
                    <Canvas Width="110" Height="110">
                        <Path Data="M 12,30 L 89,10 L 43,59 C 94,42 106,100 52,102
                                    C 34,102 26,97 21,90"
                              Stroke="#8CD2B2" StrokeThickness="7"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Fill="Transparent"/>
                    </Canvas>
                </Viewbox>
                <Viewbox Width="155" Height="155" Canvas.Right="105" Canvas.Bottom="65">
                    <Canvas Width="110" Height="110">
                        <Path Data="M 55,12 L 91,44 L 43,81 L 13,61 Z M 14,94 L 42,79 L 77,99"
                              Stroke="#8CD2B2" StrokeThickness="7"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Fill="Transparent"/>
                    </Canvas>
                </Viewbox>
            </Canvas>

            <!-- Page heading -->
            <Grid Grid.Row="0" x:Name="PageHeaderGrid"
                  Margin="0,0,0,17">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="PageHeading"
                               Text="Library"
                               FontFamily="{StaticResource HeadingFont}"
                               FontSize="24"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="PageSubtitle"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="13"
                               Margin="0,6,0,0"/>
                </StackPanel>


                <Border x:Name="HeaderStatusCard" Grid.Column="1"
                        Background="#15332F"
                        CornerRadius="20"
                        BorderBrush="#2A554F"
                        BorderThickness="1"
                        Padding="14,8"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                    <TextBlock x:Name="TopStatus"
                               Text="●  Select a game"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"/>
                </Border>
            </Grid>


            <!-- INSTANCE LIBRARY: compact tiles, search and simple filters -->
            <ScrollViewer Grid.Row="1" x:Name="InstancesPanel"
                          FocusVisualStyle="{x:Null}" Focusable="False"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,3,5">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="0,0,12,0">
                            <TextBox x:Name="InstanceSearchText" Padding="37,10,12,10"
                                     TextChanged="InstanceSearch_Changed"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Foreground="{StaticResource MutedBrush}"
                                       Margin="13,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <TextBlock x:Name="InstanceSearchHint" Text="Search instances"
                                       FontSize="13" Foreground="{StaticResource MutedBrush}"
                                       Margin="37,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                        <Button Grid.Column="1" Content="+  New instance"
                                x:Name="HeaderCreateButton"
                                Style="{StaticResource PrimaryButton}"
                                Click="CreateInstance_Click" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Button x:Name="InstanceSortButton" Content="Recently added  ▾"
                                Style="{StaticResource PillButton}" Padding="13,9"
                                Click="OpenInstanceSort_Click" Margin="0,0,9,0">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource InstanceContextMenu}">
                                    <MenuItem Style="{StaticResource InstanceMenuItem}"
                                              Header="Recently added" Tag="recent"
                                              Click="InstanceSortOption_Click"/>
                                    <MenuItem Style="{StaticResource InstanceMenuItem}"
                                              Header="Name: A to Z" Tag="name"
                                              Click="InstanceSortOption_Click"/>
                                    <MenuItem Style="{StaticResource InstanceMenuItem}"
                                              Header="Name: Z to A" Tag="name-desc"
                                              Click="InstanceSortOption_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="InstanceFilterButton" Content="All instances  ▾"
                                Style="{StaticResource PillButton}" Padding="13,9"
                                Click="OpenInstanceFilter_Click">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource InstanceContextMenu}">
                                    <MenuItem Style="{StaticResource InstanceMenuItem}"
                                              Header="All instances" Tag="all"
                                              Click="InstanceFilterOption_Click"/>
                                    <MenuItem Style="{StaticResource InstanceMenuItem}"
                                              Header="Modded copies" Tag="managed"
                                              Click="InstanceFilterOption_Click"/>
                                    <MenuItem Style="{StaticResource InstanceMenuItem}"
                                              Header="Existing installations" Tag="existing"
                                              Click="InstanceFilterOption_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <TextBlock x:Name="InstanceCountText" VerticalAlignment="Center"
                                   Margin="14,0,0,0" FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <Button Content="Import .orbuspack" Click="ImportInstance_Click"
                                Style="{StaticResource PillButton}" Margin="18,0,0,0"
                                Padding="10,6" MinHeight="30"
                                ToolTip="Create a new instance from a shared mod list"/>
                        <Button Content="Add existing game" Click="OpenInstances_Click"
                                Style="{StaticResource PillButton}" Margin="9,0,0,0"
                                Padding="10,6" MinHeight="30"
                                ToolTip="Register an OrbusVR installation you already have"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding InstanceCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="182" MinHeight="220" Margin="0,0,12,12"
                                        Padding="9" CornerRadius="16" BorderThickness="1"
                                        Background="{StaticResource CardBrush}"
                                        Tag="{Binding}" ToolTip="{Binding Readiness}"
                                        Cursor="Hand" MouseLeftButtonUp="InstanceCard_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="#8E749D"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu Style="{StaticResource InstanceContextMenu}"
                                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Style="{StaticResource InstanceMenuItem}"
                                                      Header="Play" Tag="{Binding}" Click="InstancePlay_Click"/>
                                            <MenuItem Style="{StaticResource InstanceMenuItem}"
                                                      Header="View instance" Tag="{Binding}" Click="InstanceManage_Click"/>
                                            <MenuItem Style="{StaticResource InstanceMenuItem}"
                                                      Header="Customize instance" Tag="{Binding}" Click="InstanceCustomize_Click"/>
                                            <MenuItem Style="{StaticResource InstanceMenuItem}"
                                                      Header="Export mod list" Tag="{Binding}" Click="InstanceExport_Click"/>
                                            <MenuItem Style="{StaticResource InstanceMenuItem}"
                                                      Header="Open folder" Tag="{Binding}" Click="InstanceOpenFolder_Click"/>
                                            <MenuItem Style="{StaticResource InstanceMenuItem}"
                                                      Header="Copy folder path" Tag="{Binding}" Click="InstanceCopyPath_Click"/>
                                            <MenuItem Style="{StaticResource InstanceMenuItem}"
                                                      Header="Remove from list" Tag="{Binding}" Click="InstanceForget_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <Border Height="137" CornerRadius="13"
                                                Background="{Binding CoverBrush}">
                                            <Grid ClipToBounds="True">
                                                <ContentControl ContentTemplate="{StaticResource ArcaneHexMotif}"
                                                                Width="129" Height="129"
                                                                Opacity="0.13"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                IsHitTestVisible="False"/>
                                                <ContentControl ContentTemplate="{StaticResource OrbusMark}"
                                                                 Width="77" Height="77" Opacity="0.85"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                                                     <ContentControl.Style>
                                                         <Style TargetType="ContentControl">
                                                             <Setter Property="Visibility" Value="Visible"/>
                                                             <Style.Triggers>
                                                                 <DataTrigger Binding="{Binding HasCustomIcon}" Value="True">
                                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                                 </DataTrigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </ContentControl.Style>
                                                 </ContentControl>
                                                 <!-- Entire art area is a cover, not a 105px icon. -->
                                                 <Image Source="{Binding CustomIcon}"
                                                        Width="164" Height="137" Stretch="UniformToFill"
                                                        Opacity="0.28" IsHitTestVisible="False">
                                                     <Image.Effect><BlurEffect Radius="10"/></Image.Effect>
                                                     <Image.Style>
                                                         <Style TargetType="Image">
                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                             <Style.Triggers>
                                                                 <MultiDataTrigger>
                                                                     <MultiDataTrigger.Conditions>
                                                                         <Condition Binding="{Binding HasCustomIcon}" Value="True"/>
                                                                         <Condition Binding="{Binding IconFit}" Value="True"/>
                                                                     </MultiDataTrigger.Conditions>
                                                                     <Setter Property="Visibility" Value="Visible"/>
                                                                 </MultiDataTrigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </Image.Style>
                                                 </Image>
                                                 <Image Source="{Binding CustomIcon}"
                                                        Width="164" Height="137"
                                                        RenderTransformOrigin="0.5,0.5"
                                                        IsHitTestVisible="False">
                                                     <Image.RenderTransform>
                                                         <TransformGroup>
                                                             <ScaleTransform ScaleX="{Binding IconZoom}"
                                                                             ScaleY="{Binding IconZoom}"/>
                                                             <TranslateTransform X="{Binding IconOffsetX}"
                                                                                 Y="{Binding IconOffsetY}"/>
                                                         </TransformGroup>
                                                     </Image.RenderTransform>
                                                     <Image.Style>
                                                         <Style TargetType="Image">
                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                             <Setter Property="Stretch" Value="UniformToFill"/>
                                                             <Style.Triggers>
                                                                 <DataTrigger Binding="{Binding HasCustomIcon}" Value="True">
                                                                     <Setter Property="Visibility" Value="Visible"/>
                                                                 </DataTrigger>
                                                                 <DataTrigger Binding="{Binding IconFit}" Value="True">
                                                                     <Setter Property="Stretch" Value="Uniform"/>
                                                                 </DataTrigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </Image.Style>
                                                 </Image>
                                                
                                                <!-- Actual vector paths are rendered by ContentTemplate.
                                                     These work even without Segoe MDL2 glyph support. -->
                                                <Button Content="More" Style="{StaticResource InstanceMoreButton}"
                                                        Width="32" Height="32"
                                                        Tag="{Binding}" Click="InstanceOptions_Click"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,7,7,0"
                                                        ToolTip="More instance actions"/>
                                                <Button Content="Play" Style="{StaticResource InstancePlayButton}"
                                                        Width="38" Height="37"
                                                        Tag="{Binding}" Click="InstancePlay_Click"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                        Margin="0,0,8,8" ToolTip="Play this instance"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   Margin="3,9,3,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ModCount}" FontSize="13"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="3,5,3,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Kind}" FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="3,4,3,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding GameUpdateLabel}" FontSize="12"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="SemiBold" Margin="3,4,3,5"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="EmptyInstancesPanel" Style="{StaticResource PanelCard}"
                            Padding="40" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="430">
                            <TextBlock Text="Your adventure starts here" FontSize="22"
                                       FontWeight="Bold" TextAlignment="Center"/>
                            <TextBlock Text="Add your OrbusVR installation, then create a separate copy for mods."
                                       FontSize="13" Foreground="{StaticResource MutedBrush}"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,11,0,20"/>
                            <Button Content="Add OrbusVR installation"
                                    HorizontalAlignment="Center" Click="OpenInstances_Click"
                                    Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="NoMatchingInstancesPanel" Style="{StaticResource PanelCard}"
                            Padding="36" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="No matching instances"
                                       FontSize="16" FontWeight="SemiBold" TextAlignment="Center"/>
                            <TextBlock Text="Try another search or change the filter."
                                       FontSize="13" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,9,0,15" TextAlignment="Center"/>
                            <Button Content="Clear search and filters"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource PillButton}"
                                    Click="ClearInstanceFilters_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- INSTANCE DETAILS -->
            <ScrollViewer Grid.Row="1"
                          x:Name="DashboardPanel"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,3,2">

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="CURRENT GAME"
                                       Style="{StaticResource Eyebrow}"/>

                            <TextBlock Text="Manage this installation"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,9,0,7"/>

                            <TextBlock Text="Manage the mod loader and installed mods for this game copy."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>

                            <TextBox x:Name="GamePathText"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     Margin="0,15,0,0"/>

                            <WrapPanel Margin="0,13,0,0">
                                <Button Content="Back to instances"
                                        Click="OpenInstances_Click"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,9,8"/>

                                <Button Content="+ Create a clean copy"
                                        Click="CreateInstance_Click"
                                        Style="{StaticResource PillButton}"
                                        Margin="0,0,0,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- BepInEx -->
                        <Border Grid.Column="0"
                                Style="{StaticResource PanelCard}"
                                Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="MOD LOADER"
                                           Style="{StaticResource Eyebrow}"/>

                                <TextBlock x:Name="LoaderStatusText"
                                           Text="Select a game"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,5"/>

                                <TextBlock Text="BepInEx + ModCore companion, installed for each game copy."
                                           FontSize="13"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"/>

                                <Button x:Name="InstallLoaderButton"
                                        Content="Install BepInEx + ModCore"
                                        Click="InstallLoader_Click"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,17,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Mod collection -->
                        <Border Grid.Column="1"
                                Style="{StaticResource PanelCard}"
                                Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="YOUR MODS"
                                           Style="{StaticResource Eyebrow}"/>

                                <TextBlock x:Name="ModsCountText"
                                           Text="0 managed mods"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,5"/>

                                <TextBlock Text="Install approved community releases, or test a local DLL."
                                           FontSize="13"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"/>

                                <WrapPanel Margin="0,17,0,0">
                                    <Button Content="Import local DLL"
                                            Click="ImportLocal_Click"
                                            Style="{StaticResource PillButton}"
                                            Margin="0,0,8,8"/>

                                    <Button Content="Open logs"
                                            Click="OpenLogs_Click"
                                            Style="{StaticResource PillButton}"
                                            Margin="0,0,0,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Launch -->
                    <Border Style="{StaticResource PanelCard}"
                            Margin="0,11,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ready to play?"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Launch the selected OrbusVR installation."
                                           FontSize="13"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="▶  Launch OrbusVR"
                                    Click="Launch_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="12,0,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>


            <!-- SERVER LIBRARY: instance-style server cards, not a configuration form -->
            <Grid Grid.Row="1" x:Name="ServerLibraryPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="YOUR SERVERS" Style="{StaticResource Eyebrow}"/>
                        <TextBlock x:Name="ServerLibraryCount" Text="0 saved servers"
                                   Margin="0,9,0,0" FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="Detect server" Click="DetectServer_Click"
                                Style="{StaticResource PillButton}" Margin="0,0,9,0"/>
                        <Button Content="+  Add existing server"
                                Click="BrowseServerFolder_Click"
                                Style="{StaticResource PrimaryButton}"/>
                    </WrapPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding ServerCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PanelCard}" Width="342" MinHeight="190"
                                            Margin="0,0,15,15" Padding="18">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="44" Height="44"
                                                            Background="#263B3C" CornerRadius="12">
                                                        <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   FontSize="23" VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,2,0,0">
                                                        <TextBlock Text="{Binding Name}" FontSize="16"
                                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Status}" Margin="0,6,0,0"
                                                                   FontSize="12" Foreground="{Binding StatusColor}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                                                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                           Margin="0,17,0,0"/>
                                            </StackPanel>
                                            <DockPanel Grid.Row="1" Margin="0,15,0,0" LastChildFill="False">
                                                <Button Content="Remove" DockPanel.Dock="Right"
                                                        Tag="{Binding}" Click="RemoveServer_Click"
                                                        Style="{StaticResource PillButton}"/>
                                                <Button Content="Open server  →" DockPanel.Dock="Right"
                                                        Tag="{Binding}" Click="ServerCard_Click"
                                                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border x:Name="EmptyServerLibrary" Style="{StaticResource PanelCard}"
                                Padding="32" Margin="0,4,0,0" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="No servers added yet" FontSize="18"
                                           FontWeight="SemiBold" TextAlignment="Center"/>
                                <TextBlock Text="Import your running Community Server once. It will stay in your server library."
                                           MaxWidth="420" TextWrapping="Wrap" FontSize="13"
                                           TextAlignment="Center" Margin="0,10,0,18"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <Button Content="+  Add existing server" Click="BrowseServerFolder_Click"
                                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- SELECTED SERVER: persistent header and Modrinth-style tabs -->
            <Grid Grid.Row="1" x:Name="ServerControlPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14" Padding="19">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Button Content="←  All servers" Click="BackToServers_Click"
                                    Style="{StaticResource PillButton}"
                                    HorizontalAlignment="Left" Padding="11,6" Margin="0,0,0,13"/>
                            <TextBlock x:Name="SelectedServerName" Text="Selected server"
                                       FontSize="23" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SelectedServerPathText" TextTrimming="CharacterEllipsis"
                                       Margin="0,7,15,0" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                                    Margin="16,0,0,0">
                            <TextBlock x:Name="ServerStateText" Text="Checking status"
                                       Foreground="{StaticResource AccentBrush}" FontSize="14"
                                       FontWeight="SemiBold" HorizontalAlignment="Right"
                                       Margin="0,0,0,12"/>
                            <Button x:Name="StartStopServerButton" Content="▶  Start server"
                                    Click="StartStopServer_Click" Style="{StaticResource PrimaryButton}"
                                    Padding="20,12" IsEnabled="False" MinWidth="142"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="1" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1"
                        Margin="0,0,0,13">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="OverviewTabButton" Content="Overview" Click="ServerOverviewTab_Click"
                                Style="{StaticResource PillButton}" Margin="0,0,8,11"/>
                        <Button x:Name="ServerPlayersTabButton" Content="Players" Click="ServerPlayersTab_Click"
                                Style="{StaticResource PillButton}" Margin="0,0,8,11"/>
                        <Button x:Name="ServerModsTabButton" Content="Mods" Click="ServerModsTab_Click"
                                Style="{StaticResource PillButton}" Margin="0,0,8,11"/>
                        <Button x:Name="ConsoleTabButton" Content="Console" Click="ServerConsoleTab_Click"
                                Style="{StaticResource PillButton}" Margin="0,0,8,11"/>
                    </StackPanel>
                </Border>

                <!-- OVERVIEW: just the things needed while the server is running -->
                <ScrollViewer Grid.Row="2" x:Name="ServerOverviewTab" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">
                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,13" Padding="22">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,16">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="SERVER HEALTH" Style="{StaticResource Eyebrow}"/>
                                        <TextBlock Text="Services" FontSize="17" FontWeight="SemiBold"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <Button Content="Refresh" Click="RefreshServer_Click"
                                            DockPanel.Dock="Right" VerticalAlignment="Center"
                                            Style="{StaticResource PillButton}"/>
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource CardAltBrush}" CornerRadius="10" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="GAME" Style="{StaticResource Eyebrow}"/>
                                            <TextBlock x:Name="GameServiceText" Text="—" Margin="0,10,0,0"
                                                       FontSize="21" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{StaticResource CardAltBrush}" CornerRadius="10" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="API" Style="{StaticResource Eyebrow}"/>
                                            <TextBlock x:Name="ApiServiceText" Text="—" Margin="0,10,0,0"
                                                       FontSize="21" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Background="{StaticResource CardAltBrush}" CornerRadius="10" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="OTHER SERVICES" Style="{StaticResource Eyebrow}"/>
                                            <TextBlock x:Name="OtherServicesText" Text="—" Margin="0,10,0,0"
                                                       FontSize="21" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="ServerSummaryText" Margin="0,17,0,0"
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelCard}" Padding="22" Margin="0,0,0,13">
                            <StackPanel>
                                <TextBlock Text="QUICK ACTIONS" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="Manage your world" FontSize="17" FontWeight="SemiBold"
                                           Margin="0,8,0,15"/>
                                <WrapPanel>
                                    <Button x:Name="RestartServerButton" Content="↻  Restart game + API"
                                            Click="RestartServer_Click" IsEnabled="False"
                                            Style="{StaticResource PillButton}" Margin="0,0,10,10"/>
                                    <Button x:Name="ReloadServerModsButton" Content="Reload mods"
                                            Click="ReloadServerMods_Click" IsEnabled="False"
                                            Style="{StaticResource PillButton}" Margin="0,0,10,10"/>
                                    <Button Content="Open server folder" Click="OpenServerFolder_Click"
                                            Style="{StaticResource PillButton}" Margin="0,0,10,10"/>
                                </WrapPanel>
                                <TextBlock Text="Restarting disconnects online players. Stop preserves your server database."
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelCard}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource Eyebrow}"/>
                                <TextBlock x:Name="ServerActivityText" Text="No actions this session."
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,11,0,0" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- PLAYERS: persistent server character history with verified presence only -->
                <Grid Grid.Row="2" x:Name="ServerPlayersTab" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PLAYER DIRECTORY" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="Characters &amp; Items" FontSize="19" FontWeight="SemiBold"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                        <Button x:Name="PlayerRefreshButton" Grid.Column="1"
                                Content="↻  Refresh players" Click="PlayerRefresh_Click"
                                Style="{StaticResource PillButton}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="16">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource CardAltBrush}" CornerRadius="9" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="SAVED CHARACTERS" Style="{StaticResource Eyebrow}"/>
                                                <TextBlock x:Name="PlayerHistoryCountText" Text="—"
                                                           FontSize="24" Margin="0,9,0,0" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="{StaticResource CardAltBrush}"
                                                CornerRadius="9" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="ONLINE NOW" Style="{StaticResource Eyebrow}"/>
                                                <TextBlock x:Name="PlayerOnlineCountText" Text="—"
                                                           FontSize="24" Margin="0,9,0,0" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="SEARCH CHARACTERS" Style="{StaticResource Eyebrow}"
                                               Margin="0,0,0,8"/>
                                    <TextBox x:Name="PlayerSearchText" ToolTip="Search saved characters"
                                             TextChanged="PlayerSearch_Changed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,10">
                                        <Button x:Name="PlayerAllButton" Content="All characters"
                                                Click="PlayerAll_Click" Style="{StaticResource PillButton}"
                                                Padding="11,6" Margin="0,0,8,0"/>
                                        <Button x:Name="PlayerOnlineButton" Content="Online"
                                                Click="PlayerOnline_Click" Style="{StaticResource PillButton}"
                                                Padding="11,6"/>
                                    </StackPanel>
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding VisibleServerPlayers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Tag="{Binding}" Click="SelectServerPlayer_Click"
                                                            Style="{StaticResource PillButton}"
                                                            HorizontalContentAlignment="Stretch"
                                                            Margin="0,0,0,7" Padding="12">
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding PresenceText}" DockPanel.Dock="Right"
                                                                       FontSize="10" Margin="8,0,0,0"
                                                                       Foreground="{StaticResource MutedBrush}"/>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                       FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="EmptyServerPlayersText"
                                                   Text="Open the directory to load characters."
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="3,9,3,9"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource PanelCard}" Padding="17" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="SOURCE" Style="{StaticResource Eyebrow}"/>
                                        <TextBlock x:Name="PlayerDirectoryInfoText"
                                                   Text="Character history loads when you open this tab."
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock x:Name="PlayerDiagnosticText"
                                                   TextWrapping="Wrap" FontSize="11"
                                                   Foreground="#E8BA93" Margin="0,10,0,0"
                                                   Visibility="Collapsed"/>
                                        <Button Content="Copy diagnostic details"
                                                Click="CopyPlayerDiagnostics_Click"
                                                Style="{StaticResource PillButton}"
                                                HorizontalAlignment="Left" Padding="9,5"
                                                Margin="0,11,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PlayerSelectionEmpty" Style="{StaticResource PanelCard}" Padding="25">
                                    <StackPanel>
                                        <TextBlock Text="Select a character" FontWeight="SemiBold" FontSize="18"/>
                                        <TextBlock Text="Choose someone from the directory to prepare an item grant."
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Margin="0,11,0,0" Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PlayerProfilePanel" Style="{StaticResource PanelCard}"
                                        Visibility="Collapsed" Padding="19">
                                    <StackPanel>
                                        <TextBlock Text="CHARACTER PROFILE" Style="{StaticResource Eyebrow}"/>
                                        <TextBlock x:Name="PlayerProfileNameText" Text="—" FontSize="22"
                                                   Margin="0,10,0,5" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="PlayerProfilePresenceText" Text="—"
                                                   FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                        <Border Height="1" Background="{StaticResource StrokeBrush}"
                                                Margin="0,20,0,18"/>
                                        <TextBlock Text="GIVE ITEM" Style="{StaticResource Eyebrow}"/>
                                        <TextBlock Text="The recipient can be offline. Grants use the Community Server's admin command."
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,10,0,12"/>
                                        <TextBlock Text="SEARCH ITEMS BY NAME OR ID" Style="{StaticResource Eyebrow}"
                                                   Margin="0,4,0,8"/>
                                        <TextBox x:Name="PlayerItemSearchText"
                                                 ToolTip="Search by item name or numeric ID"
                                                 TextChanged="PlayerItemSearch_Changed"/>
                                        <ComboBox x:Name="PlayerItemSelect" Margin="0,10,0,0"
                                                  MinHeight="38" FontSize="12"
                                                  Background="{StaticResource CardAltBrush}"
                                                  Foreground="{StaticResource TextBrush}"
                                                  BorderBrush="{StaticResource StrokeBrush}"
                                                  MaxDropDownHeight="250"
                                                  ItemsSource="{Binding VisiblePlayerItems}"
                                                  DisplayMemberPath="Label"
                                                  SelectionChanged="PlayerItemSelect_Changed"/>
                                        <TextBlock x:Name="PlayerItemCountText" Text=""
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,7,0,0" FontSize="11"/>
                                        <Button x:Name="PlayerGiftButton" Content="Give selected item"
                                                Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"
                                                IsEnabled="False" Click="GivePlayerItem_Click"/>
                                        <TextBlock x:Name="PlayerGiftStatusText"
                                                   Text="Choose an item before sending an admin request."
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- MODS: installed components and a compact curated catalogue -->
                <ScrollViewer Grid.Row="2" x:Name="ServerPanel" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">
                        <Border Style="{StaticResource PanelCard}" Padding="20" Margin="0,0,0,13">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="INSTALLED COMPONENTS" Style="{StaticResource Eyebrow}"/>
                                        <TextBlock Text="Server mods" FontSize="18" FontWeight="SemiBold"
                                                   Margin="0,7,0,0"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Content="+  Import .js" Click="ImportServerComponent_Click"
                                                Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                                        <Button Content="Refresh" Click="RefreshServerComponents_Click"
                                                Style="{StaticResource PillButton}"/>
                                    </WrapPanel>
                                </Grid>
                                <TextBlock x:Name="ServerComponentPathText" TextTrimming="CharacterEllipsis"
                                           Margin="0,12,0,15" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <ItemsControl ItemsSource="{Binding InstalledServerComponents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardAltBrush}" Padding="13"
                                                    CornerRadius="8" Margin="0,0,0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13"/>
                                                        <TextBlock Text="{Binding Status}" FontSize="11"
                                                                   Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="{Binding ActionLabel}"
                                                            Tag="{Binding}" Click="ToggleServerComponent_Click"
                                                            Style="{StaticResource PillButton}" Margin="12,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="EmptyInstalledServerComponents"
                                           Text="No components installed yet. Import a trusted .js file to start."
                                           Foreground="{StaticResource MutedBrush}" FontSize="12"
                                           Margin="0,8,0,0"/>
                                <DockPanel Margin="0,15,0,0" LastChildFill="False">
                                    <TextBlock Text="Mod changes apply after a server restart."
                                               Foreground="{StaticResource MutedBrush}" FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <Button Content="Restart game to apply" Click="ReloadServerMods_Click"
                                            Style="{StaticResource PillButton}" DockPanel.Dock="Right"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelCard}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="DISCOVER" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="Server mod catalogue" FontSize="18" FontWeight="SemiBold"
                                           Margin="0,8,0,13"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ServerSearchText" VerticalContentAlignment="Center"
                                             ToolTip="Search approved server mods"
                                             TextChanged="ServerSearchText_Changed"/>
                                    <Button Grid.Column="1" Content="Refresh catalogue"
                                            Click="RefreshCatalog_Click"
                                            Style="{StaticResource PillButton}" Margin="10,0,0,0"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ServerMods}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardAltBrush}" CornerRadius="9"
                                                    Padding="15" Margin="0,0,0,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Author}" FontSize="11" Margin="0,4,0,0"
                                                                   Foreground="{StaticResource MutedBrush}"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="12"
                                                                   TextWrapping="Wrap" Margin="0,7,0,0"
                                                                   Foreground="{StaticResource MutedBrush}"/>
                                                        <TextBlock Text="{Binding Status}" FontSize="11"
                                                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                                                   Foreground="{StaticResource MutedBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="16,0,0,0"
                                                                VerticalAlignment="Center">
                                                        <Button Content="Install / Update" Tag="{Binding}"
                                                                Click="InstallServerCatalogMod_Click"
                                                                IsEnabled="{Binding CanClick}"
                                                                Style="{StaticResource PrimaryButton}" Margin="0,0,0,7"/>
                                                        <Button Content="View source" Tag="{Binding}"
                                                                Style="{StaticResource PillButton}"
                                                                Click="OpenGithub_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border x:Name="EmptyServerPanel" Background="{StaticResource CardAltBrush}"
                                        CornerRadius="9" Padding="22" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="No approved server mods yet"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="The curated catalogue will appear here when server components are published. You can still import your own scripts above."
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Margin="0,8,0,0" TextAlignment="Center"
                                                   Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- CONSOLE: log tab, automatically refreshed only while open -->
                <Grid Grid.Row="2" x:Name="ServerConsoleTab" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SERVER CONSOLE" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="Game + API output" FontSize="17"
                                       FontWeight="SemiBold" Margin="0,7,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ConsoleAutoRefreshCheck" Content="Auto-refresh"
                                      IsChecked="True" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <Button Content="Refresh" Click="ViewServerLogs_Click"
                                    Style="{StaticResource PillButton}" Margin="0,0,8,0"/>
                            <Button Content="Copy logs" Click="CopyServerLogs_Click"
                                    Style="{StaticResource PillButton}"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="#111319" CornerRadius="10"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                            Padding="12">
                        <TextBox x:Name="ServerLogsText" FontFamily="Consolas" FontSize="12"
                                 Background="#111319" BorderThickness="0" Padding="5"
                                 Foreground="#C0D9D0" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="Console output appears here when you open this tab."/>
                    </Border>
                    <TextBlock Grid.Row="2" x:Name="ConsoleStatusText"
                               Text="Showing recent game and API output."
                               FontSize="11" Foreground="{StaticResource MutedBrush}"
                               Margin="3,10,0,2"/>
                </Grid>
            </Grid>

            <!-- BROWSE MODS -->
            <Grid Grid.Row="1"
                  x:Name="DiscoverPanel"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchText"
                             ToolTip="Search mods"
                             TextChanged="SearchText_Changed"
                             VerticalContentAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="Check updates"
                            Click="CheckUpdates_Click"
                            Style="{StaticResource PillButton}"
                            Margin="10,0,0,0"/>

                    <Button Grid.Column="2"
                            Content="Refresh"
                            Click="RefreshCatalog_Click"
                            Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,3,0">
                        <Border Background="{StaticResource CardBrush}"
                                CornerRadius="14"
                                Padding="13"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="ModBrowseScopeText"
                                           Text="GLOBAL MOD LIBRARY · Choose an instance when installing"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CatalogInfo"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12" Margin="0,6,0,0"
                                           Text="Approved community mods"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding DiscoverMods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PanelCard}"
                                            Margin="0,0,0,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="76"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Distinct original artwork; works offline and scales crisply. -->
                                            <Image Grid.Column="0"
                                                   Source="{Binding IconSource, Mode=OneWay}"
                                                   Width="64" Height="64"
                                                   Stretch="Uniform"
                                                   VerticalAlignment="Top"
                                                   Margin="0,1,12,0"
                                                   ToolTip="{Binding Name, Mode=OneWay}"
                                                   SnapsToDevicePixels="True"/>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                           FontWeight="Bold"
                                                           FontSize="18"/>

                                                <!-- Crash fix:
                                                     Run.Text can default to a
                                                     two-way binding. Author
                                                     is a read-only property,
                                                     so bind explicitly OneWay. -->
                                                <TextBlock Foreground="{StaticResource MutedBrush}"
                                                           FontSize="12"
                                                           Margin="0,6,0,0">
                                                    <Run Text="by "/>
                                                    <Run Text="{Binding Author, Mode=OneWay}"/>
                                                    <Run Text="  ·  "/>
                                                    <Run Text="{Binding Version, Mode=OneWay}"/>
                                                </TextBlock>

                                                <TextBlock Text="{Binding Description, Mode=OneWay}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextWrapping="Wrap"
                                                           FontSize="13"
                                                           Margin="0,10,0,0"/>

                                                <TextBlock Text="{Binding Status, Mode=OneWay}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="12"
                                                           Margin="0,10,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        Margin="16,0,0,0"
                                                        VerticalAlignment="Center">
                                                <Button Content="{Binding Action, Mode=OneWay}"
                                                        Tag="{Binding}"
                                                        IsEnabled="{Binding CanClick, Mode=OneWay}"
                                                        Click="ModAction_Click"
                                                        Style="{StaticResource PrimaryButton}"
                                                        MinWidth="110"/>

                                                <Button Content="View on GitHub"
                                                        Tag="{Binding}"
                                                        Click="OpenGithub_Click"
                                                        Style="{StaticResource PillButton}"
                                                        Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty catalogue -->
                        <Border x:Name="EmptyCatalogText"
                                Style="{StaticResource PanelCard}"
                                Padding="38">
                            <StackPanel HorizontalAlignment="Center"
                                        MaxWidth="400">
                                <TextBlock Text="No mods published yet"
                                           FontWeight="Bold"
                                           FontSize="20"
                                           TextAlignment="Center"/>

                                <TextBlock Text="Approved community mods will appear here automatically."
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,10,0,0"
                                           FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Selected instance: a compact launcher header and a full-width,
                 aligned mod table. No redundant title or giant cards. -->
            <Grid Grid.Row="1" x:Name="InstalledPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,13">
                    <Button Content="←  Library" Click="Instances_Click"
                            Style="{StaticResource PillButton}"
                            HorizontalAlignment="Left"
                            Padding="9,5" MinHeight="27"
                            FontSize="12" Margin="0,0,0,17"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="61" Height="61" CornerRadius="13"
                                Background="#353947" VerticalAlignment="Center">
                            <Grid>
                                <ContentControl x:Name="SelectedInstanceLogo"
                                                ContentTemplate="{StaticResource OrbusMark}"
                                                Width="47" Height="47"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                <Image x:Name="SelectedInstanceArtwork"
                                       Width="53" Height="53" Stretch="UniformToFill"
                                       Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="14,0,12,0">
                            <TextBlock x:Name="SelectedInstanceName"
                                       FontFamily="{StaticResource HeadingFont}"
                                       FontSize="23" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock x:Name="SelectedInstanceMeta"
                                           FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="    ·    " FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="SelectedInstanceLoaderText"
                                           FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="More" Style="{StaticResource InstanceMoreButton}"
                                    Click="SelectedInstanceOptions_Click"
                                    Width="36" Height="36" Margin="0,0,9,0"
                                    ToolTip="Instance options">
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource InstanceContextMenu}">
                                        <MenuItem Style="{StaticResource InstanceMenuItem}"
                                                  Header="Customize instance" Click="EditSelectedInstance_Click"/>
                                        <MenuItem Style="{StaticResource InstanceMenuItem}"
                                                  Header="Export mod list" Click="ExportSelectedInstance_Click"/>
                                        <MenuItem Style="{StaticResource InstanceMenuItem}"
                                                  Header="Open game folder" Click="SelectedOpenFolder_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Content="Open folder"
                                    Style="{StaticResource PillButton}"
                                    Click="SelectedOpenFolder_Click"
                                    MinHeight="36" Padding="12,8" Margin="0,0,9,0"/>
                            <Button Content="Plugins"
                                    Style="{StaticResource PillButton}"
                                    Click="SelectedOpenModsFolder_Click"
                                    MinHeight="36" Padding="12,8" Margin="0,0,9,0"/>
                            <Button x:Name="SelectedLoaderButton"
                                    Content="Install BepInEx + ModCore"
                                    Style="{StaticResource PillButton}"
                                    Click="InstallLoader_Click"
                                    Visibility="Collapsed"
                                    MinHeight="36" Padding="12,8" Margin="0,0,9,0"/>
                            <Button Content="▶  Play" Click="Launch_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="99" MinHeight="39"
                                    Padding="14,8"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="GameUpdateControls" Margin="0,14,0,1"
                                Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="GameUpdateStatusText"
                                           Text="Checking for game updates..."
                                           FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Keeps mods and settings. Previous files retained for rollback."
                                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button x:Name="GameUpdateCheckButton" Content="Check for updates"
                                        Style="{StaticResource PillButton}"
                                        MinHeight="35" Padding="11,7" Margin="0,0,7,0"
                                        Click="CheckGameUpdates_Click"/>
                                <Button x:Name="GameRollbackButton" Content="Rollback"
                                        Style="{StaticResource PillButton}"
                                        Visibility="Collapsed"
                                        MinHeight="35" Padding="11,7" Margin="0,0,7,0"
                                        Click="RollbackGame_Click"/>
                                <Button x:Name="GameUpdateButton" Content="Update game"
                                        Style="{StaticResource PrimaryButton}"
                                        Visibility="Collapsed"
                                        MinHeight="35" Padding="11,7" Click="UpdateGame_Click"/>
                                <Button x:Name="GameUpdateCancelButton" Content="Cancel"
                                        Style="{StaticResource PillButton}"
                                        Visibility="Collapsed"
                                        MinHeight="35" Padding="11,7"
                                        Click="CancelGameUpdate_Click"/>
                            </StackPanel>
                        </Grid>
                        <ProgressBar x:Name="GameUpdateProgress" Maximum="100"
                                     Height="4" Visibility="Collapsed" Margin="0,12,0,0"
                                     Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="SelectedInstancePathText" Visibility="Collapsed"/>
                    <TextBlock x:Name="SelectedInstanceWarning"
                               FontSize="12" Foreground="#F0C79C"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <Border Grid.Row="1" Height="1"
                        Background="{StaticResource StrokeBrush}"
                        Margin="0,6,0,19"/>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- One toolbar: title and install actions -->
                    <Grid Grid.Row="0" Margin="0,0,0,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Mods" FontSize="18" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="InstalledCountLabel"
                                       FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="Import DLL" Click="ImportLocal_Click"
                                    Style="{StaticResource PillButton}"
                                    MinHeight="35" Padding="11,7" Margin="0,0,8,0"/>
                            <Button Content="+  Browse mods" Click="Discover_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    MinHeight="35" Padding="12,7"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Margin="0,0,10,0">
                            <TextBox x:Name="InstalledSearchText"
                                     TextChanged="InstalledSearch_Changed"
                                     Padding="35,8,12,8" MinHeight="38"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock Text="⌕" FontSize="21"
                                       Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       IsHitTestVisible="False"/>
                            <TextBlock x:Name="InstalledSearchHint"
                                       Text="Search installed mods"
                                       FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="35,0,0,0"
                                       IsHitTestVisible="False"/>
                        </Grid>
                        <Button Grid.Column="1" Content="Check for updates"
                                Style="{StaticResource PillButton}"
                                Click="SelectedCheckModUpdates_Click"
                                MinHeight="38" Padding="12,8"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="FilterAllButton" Content="All" Tag="all"
                                    Click="InstalledFilter_Click"
                                    Style="{StaticResource PillButton}"
                                    MinHeight="30" Padding="12,6" Margin="0,0,6,0"/>
                            <Button x:Name="FilterEnabledButton" Content="Enabled" Tag="enabled"
                                    Click="InstalledFilter_Click"
                                    Style="{StaticResource PillButton}"
                                    MinHeight="30" Padding="12,6" Margin="0,0,6,0"/>
                            <Button x:Name="FilterDisabledButton" Content="Disabled" Tag="disabled"
                                    Click="InstalledFilter_Click"
                                    Style="{StaticResource PillButton}"
                                    MinHeight="30" Padding="12,6" Margin="0,0,6,0"/>
                            <Button x:Name="FilterUpdatesButton" Content="Updates" Tag="updates"
                                    Click="InstalledFilter_Click"
                                    Style="{StaticResource PillButton}"
                                    MinHeight="30" Padding="12,6"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="Only manager-installed mods appear here"
                                   FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Entire list is one surface, with unobtrusive row separators -->
                    <Border Grid.Row="3" Background="Transparent"
                            BorderThickness="0" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="41"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#292A32"
                                    CornerRadius="10,10,0,0"
                                    BorderBrush="{StaticResource StrokeBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="15,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="215"/>
                                        <ColumnDefinition Width="176"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="MOD" FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="VERSION"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="ACTIONS"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" Focusable="False"
                                          FocusVisualStyle="{x:Null}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding InstalledMods}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#22232A" Padding="15,10"
                                                        BorderBrush="{StaticResource StrokeBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        MinHeight="65">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="215"/>
                                                            <ColumnDefinition Width="176"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <Image Source="{Binding IconSource, Mode=OneWay}"
                                                                   Width="48" Height="48"
                                                                   Stretch="Uniform"
                                                                   Margin="0,0,13,0"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip="{Binding Name, Mode=OneWay}"/>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                                           FontSize="14" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <StackPanel Orientation="Horizontal"
                                                                            Margin="0,4,0,0">
                                                                    <TextBlock Text="{Binding Author, Mode=OneWay}"
                                                                               Foreground="{StaticResource MutedBrush}"
                                                                               FontSize="12"/>
                                                                    <TextBlock Text="   ·   " FontSize="12"
                                                                               Foreground="{StaticResource MutedBrush}"/>
                                                                    <TextBlock Text="{Binding Status, Mode=OneWay}"
                                                                               FontSize="12"
                                                                               Foreground="{Binding StatusBrush}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                                    Margin="8,0,5,0">
                                                            <TextBlock Text="{Binding Version, Mode=OneWay}"
                                                                       FontSize="13" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding AssetDisplay, Mode=OneWay}"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       FontSize="11"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,4,0,0"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center">
                                                            <Button Content="Update" Tag="{Binding}"
                                                                    Click="InstalledUpdate_Click"
                                                                    Margin="0,0,9,0" MinHeight="30"
                                                                    Padding="9,5">
                                                                <Button.Style>
                                                                    <Style TargetType="Button"
                                                                           BasedOn="{StaticResource PrimaryButton}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding CanUpdate}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <Button Tag="{Binding}" Click="InstalledToggle_Click"
                                                                    Style="{StaticResource ModSwitchButton}"
                                                                    IsEnabled="{Binding CanModify}"
                                                                    Margin="0,0,12,0"/>
                                                            <Button Tag="{Binding}"
                                                                    Click="InstalledUninstall_Click"
                                                                    Style="{StaticResource ModIconActionButton}"
                                                                    ToolTip="Remove this mod">
                                                                <Viewbox Width="16" Height="16" Stretch="Uniform">
                                                                    <Canvas Width="20" Height="20">
                                                                        <Path Data="M 4,6 L 16,6 M 7,6 L 7.7,17 L 12.3,17 L 13,6 M 8,4 L 12,4"
                                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                              StrokeThickness="1.7"
                                                                              StrokeStartLineCap="Round"
                                                                              StrokeEndLineCap="Round"
                                                                              StrokeLineJoin="Round"
                                                                              Fill="Transparent"/>
                                                                    </Canvas>
                                                                </Viewbox>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border x:Name="EmptyInstalledText" Background="Transparent"
                                            Padding="35,36">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="No mods installed yet"
                                                       FontSize="17" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Find approved client mods or import your own DLL."
                                                       FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Margin="0,7,0,16" TextAlignment="Center"/>
                                            <Button Content="Browse mods"
                                                    Click="Discover_Click"
                                                    HorizontalAlignment="Center"
                                                    Style="{StaticResource PrimaryButton}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="NoMatchingInstalledText"
                                            Background="Transparent" Padding="33"
                                            Visibility="Collapsed">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="No matching mods"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                            <Button Content="Clear search and filters"
                                                    Margin="0,13,0,0"
                                                    Style="{StaticResource PillButton}"
                                                    Click="InstalledClearFilters_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="SelectedModSummary" Visibility="Collapsed"/>
                </Grid>
            </Grid>

            <!-- COMMUNITY / SUPPORT: visible in primary navigation, not buried in Settings. -->
            <ScrollViewer Grid.Row="1" x:Name="CommunityPanel" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,5,10">
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Need help or want to contribute?" FontSize="19"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Bug reports and community mods help us make Orbus Reborn better. These options open our public GitHub pages."
                                       FontSize="13" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,8,0,14"/>
                            <WrapPanel>
                                <Button Content="Report a bug" Style="{StaticResource PrimaryButton}"
                                        Tag="https://github.com/Hor1zonVR/OrbusRebornManager/issues/new"
                                        Click="SupportLink_Click" Margin="0,0,9,8"/>
                                <Button Content="Submit a mod" Style="{StaticResource PillButton}"
                                        Click="SubmitMod_Click" Margin="0,0,9,8"/>
                                <Button Content="Developer guide" Style="{StaticResource PillButton}"
                                        Tag="https://github.com/Hor1zonVR/OrbusRebornManager/blob/main/docs/MODDING_GUIDE.md"
                                        Click="SupportLink_Click" Margin="0,0,9,8"/>
                                <Button Content="RebornManager GitHub" Style="{StaticResource PillButton}"
                                        Tag="https://github.com/Hor1zonVR/OrbusRebornManager"
                                        Click="SupportLink_Click" Margin="0,0,0,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Frequently asked questions" FontSize="18" FontWeight="SemiBold"
                               Margin="0,7,0,12"/>
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,9">
                        <StackPanel>
                            <TextBlock Text="Which version of OrbusVR should I choose?"
                                       FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Community Edition is the original community client. Orbus Renewed is maintained by FourOfSpades and includes additional fixes and features. Both can be installed separately."
                                       FontSize="13" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,9">
                        <StackPanel>
                            <TextBlock Text="Where will the mod be installed?"
                                       FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="From the main Mods page, RM asks you to choose an instance. From an instance's Browse mods button, installation targets that instance only. Server mods never install into a PC game."
                                       FontSize="13" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,9">
                        <StackPanel>
                            <TextBlock Text="Can I install a mod on both Community and Renewed?"
                                       FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Mods must be compatible with the exact client build. BepInEx working does not guarantee every plugin works. Keep separate game instances and test experimental mods before sharing them."
                                       FontSize="13" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,9">
                        <StackPanel>
                            <TextBlock Text="How do I make my own mod?"
                                       FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Use the appropriate Unity IL2CPP BepInEx setup, build against the selected game's generated interop references, publish a compiled release, and submit its GitHub repository for catalogue review. Read the developer guide for the full process."
                                       FontSize="13" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,7,0,12"/>
                            <Button Content="Read the modding guide" Style="{StaticResource PillButton}"
                                    Tag="https://github.com/Hor1zonVR/OrbusRebornManager/blob/main/docs/MODDING_GUIDE.md"
                                    Click="SupportLink_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Discord support links can be added when an official invite or support channel URL is provided."
                               FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="5,7,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- SETTINGS -->
            <ScrollViewer Grid.Row="1"
                          x:Name="SettingsPanel"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,3,0">
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,11">
                        <StackPanel>
                            <TextBlock Text="STORAGE" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="Instance location" FontSize="17"
                                       FontWeight="SemiBold" Margin="0,10,0,7"/>
                            <TextBlock Text="New game copies are saved here by default."
                                       FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="DefaultInstanceFolderText" FontSize="13"
                                       TextWrapping="Wrap" Margin="0,12,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Change location"
                                        Click="ChangeInstanceStorage_Click"
                                        Style="{StaticResource PillButton}"/>
                                <Button Content="Open folder" Margin="8,0,0,0"
                                        Click="OpenInstanceStorage_Click"
                                        Style="{StaticResource PillButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,11">
                        <StackPanel>
                            <TextBlock Text="FIRST-TIME SETUP" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="Try the welcome experience"
                                       FontSize="17" FontWeight="SemiBold" Margin="0,9,0,7"/>
                            <TextBlock Text="Preview what a new player sees when selecting their game and creating their first instance. This preview does not change your settings or copy any game files."
                                       FontSize="13" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,13"/>
                            <Button Content="Preview first-launch setup"
                                    Style="{StaticResource PillButton}"
                                    Click="PreviewFirstRun_Click"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="APPLICATION" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="OrbusManager updates" FontSize="17"
                                       FontWeight="SemiBold" Margin="0,10,0,8"/>
                            <TextBlock x:Name="ManagerVersionText" FontSize="13"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="ManagerUpdateStatusText" FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,9,0,0"/>
                            <ProgressBar x:Name="ManagerUpdateProgress" Height="6" Maximum="100"
                                         Foreground="{StaticResource AccentBrush}"
                                         Visibility="Collapsed" Margin="0,13,0,0"/>
                            <CheckBox x:Name="CheckManagerUpdatesCheck"
                                      Content="Check for OrbusManager updates when the app opens"
                                      Margin="0,17,0,13"/>
                            <Button x:Name="CheckManagerUpdatesButton"
                                    Content="Check for updates" Click="CheckManagerUpdates_Click"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource PillButton}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="MOD UPDATES"
                                       Style="{StaticResource Eyebrow}"/>

                            <TextBlock Text="Keep your mods up to date"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,8"/>

                            <TextBlock Text="The manager checks approved mods on GitHub when you open it."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>

                            <CheckBox x:Name="AutoUpdatesCheck"
                                      Margin="0,19,0,17"
                                      Content="Install available mod updates automatically while OrbusVR is closed"/>

                            <Button Content="Save settings"
                                    Click="SaveSettings_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- App installation management -->
                    <Border Style="{StaticResource PanelCard}" Margin="0,11,0,0">
                        <StackPanel>
                            <TextBlock Text="INSTALLATION" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="Remove OrbusManager" FontSize="16"
                                       FontWeight="SemiBold" Margin="0,10,0,8"/>
                            <TextBlock Text="Uninstall the app while keeping your OrbusVR instances and settings."
                                       FontSize="13" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <Button x:Name="UninstallManagerButton"
                                    Content="Uninstall OrbusManager"
                                    Click="UninstallManager_Click"
                                    IsEnabled="False"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource PillButton}"
                                    Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Legacy controller fields, hidden from users -->
                    <StackPanel Visibility="Collapsed">
                        <TextBox x:Name="CatalogUrlText"/>
                        <TextBox x:Name="NewRepoText"/>
                        <TextBox x:Name="NewNameText"/>
                        <TextBox x:Name="NewAssetText"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- STATUS BAR -->
            <Border Grid.Row="2"
                    Background="Transparent"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="0,10,0,0"
                    Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="UpdateActionButton" Grid.Column="1"
                            Content="Update &amp; restart"
                            Click="UpdateAction_Click"
                            Style="{StaticResource PrimaryButton}"
                            Visibility="Collapsed"
                            Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusLine"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Text="Ready"
                               TextTrimming="CharacterEllipsis"/>

                    <ProgressBar x:Name="ActivityBar"
                                 Grid.Column="2"
                                 Width="85"
                                 Height="5"
                                 Foreground="{StaticResource AccentBrush}"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 Margin="12,0,0,0"
                                 VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </Grid>
</Window>
