<Window x:Class="OrbusRebornManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbus Reborn Manager" Width="1220" Height="810" MinWidth="990" MinHeight="675"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#101723" BorderBrush="#293548" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,24,18,18">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="9,4,0,34">
                        <Border Background="#66D7BB" Width="42" Height="42" CornerRadius="11" Margin="0,0,11,0">
                            <TextBlock Text="O" Foreground="#0B1E1B" FontWeight="Black" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ORBUS" FontSize="20" FontWeight="Black"/>
                            <TextBlock Text="REBORN MANAGER" FontSize="9" FontWeight="Bold" Foreground="#66D7BB"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Margin="14,0,0,9" Text="WORKSPACE" FontSize="10" Foreground="#75879C" FontWeight="Bold"/>
                    <Button x:Name="NavHome" Content="⌂   Dashboard" Click="Dashboard_Click" Style="{StaticResource SidebarButton}"/>
                    <Button x:Name="NavBrowse" Content="▦   Discover mods" Click="Discover_Click" Style="{StaticResource SidebarButton}"/>
                    <Button x:Name="NavInstalled" Content="↓   Installed mods" Click="Installed_Click" Style="{StaticResource SidebarButton}"/>
                    <Button x:Name="NavSettings" Content="⚙   Settings / Curator" Click="Settings_Click" Style="{StaticResource SidebarButton}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <Border Background="#1B2635" CornerRadius="12" Padding="13" Margin="0,10,0,14">
                        <StackPanel>
                            <TextBlock Text="BUILT FOR REBORN" FontSize="10" FontWeight="Bold" Foreground="#66D7BB"/>
                            <TextBlock Text="Windows PC · IL2CPP" FontSize="11" Foreground="#B2C1D2" Margin="0,5,0,0"/>
                            <TextBlock Text="Classic / Preborn not supported" TextWrapping="Wrap" FontSize="10" Foreground="#778AA1" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="ORBUS REBORN MANAGER  ·  V0.1" FontSize="9" Foreground="#6C8198" HorizontalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- Main -->
        <Grid Grid.Column="1" Margin="32,24,32,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PageHeading" Text="Dashboard" FontSize="30" FontWeight="Bold"/>
                    <TextBlock x:Name="PageSubtitle" Text="Your home for OrbusVR Reborn Community Edition mods." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#162D2A" CornerRadius="19" Padding="13,7" VerticalAlignment="Center">
                    <TextBlock x:Name="TopStatus" Text="●  Select game folder" Foreground="#66D7BB" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </Grid>
            <!-- Dashboard -->
            <ScrollViewer Grid.Row="1" x:Name="DashboardPanel" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="01  /  SELECT INSTALLATION" FontWeight="Bold" FontSize="11" Foreground="#66D7BB"/>
                            <TextBlock Text="OrbusVR Reborn" FontSize="21" FontWeight="Bold" Margin="0,10,0,6"/>
                            <TextBlock Text="Choose the directory containing vrclient.exe. Your existing installation will not be moved." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12"/>
                            <Grid Margin="0,17,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="GamePathText" VerticalContentAlignment="Center" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="Browse folder" Style="{StaticResource PillButton}" Margin="10,0,0,0" Click="BrowseFolder_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PanelCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="02  /  MOD LOADER" FontWeight="Bold" FontSize="11" Foreground="#66D7BB"/>
                                <TextBlock x:Name="LoaderStatusText" Text="Not checked" FontSize="20" FontWeight="Bold" Margin="0,12,0,5"/>
                                <TextBlock Text="BepInEx Unity IL2CPP · win-x64 · build 788" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                <Button x:Name="InstallLoaderButton" Content="Install BepInEx" Style="{StaticResource PrimaryButton}" Margin="0,19,0,0" HorizontalAlignment="Left" Click="InstallLoader_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PanelCard}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="03  /  QUICK ACTIONS" FontWeight="Bold" FontSize="11" Foreground="#66D7BB"/>
                                <TextBlock x:Name="ModsCountText" Text="0 managed mods" FontSize="20" FontWeight="Bold" Margin="0,12,0,5"/>
                                <TextBlock Text="Install a local development DLL while public releases are being prepared." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                <WrapPanel Margin="0,15,0,0">
                                    <Button Content="Import local DLL" Style="{StaticResource PillButton}" Click="ImportLocal_Click" Margin="0,0,8,8"/>
                                    <Button Content="Open logs" Style="{StaticResource PillButton}" Click="OpenLogs_Click" Margin="0,0,0,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource PanelCard}" Margin="0,16,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Ready to play?" FontSize="19" FontWeight="SemiBold"/>
                                <TextBlock Text="Launch the selected Reborn installation." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Button Content="▶  Launch OrbusVR" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="12,0,0,0" Click="Launch_Click"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <!-- Discover -->
            <Grid x:Name="DiscoverPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchText" VerticalContentAlignment="Center" TextChanged="SearchText_Changed" ToolTip="Filter mods by name, description or author"/>
                    <Button Grid.Column="1" Content="Check updates" Style="{StaticResource PillButton}" Margin="12,0,0,0" Click="CheckUpdates_Click"/>
                    <Button Grid.Column="2" Content="Refresh" Style="{StaticResource PillButton}" Margin="8,0,0,0" Click="RefreshCatalog_Click"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#182A33" CornerRadius="11" Padding="14" Margin="0,0,0,12">
                            <TextBlock x:Name="CatalogInfo" Text="Only GitHub repos approved by the catalogue curator appear here." Foreground="#BFD7DB" FontSize="12" TextWrapping="Wrap"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding DiscoverMods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="18"/>
                                                <TextBlock Foreground="#66D7BB" FontSize="11" Margin="0,4,0,0"><Run Text="by "/><Run Text="{Binding Author}"/><Run Text="  ·  "/><Run Text="{Binding Version}"/></TextBlock>
                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,11,0,0" FontSize="12" MaxWidth="600"/>
                                                <TextBlock Text="{Binding Status}" Foreground="#B9CBE0" Margin="0,10,0,0" FontSize="11"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                                <Button Content="{Binding Action}" Tag="{Binding}" IsEnabled="{Binding CanClick}" Style="{StaticResource PrimaryButton}" MinWidth="105" Click="ModAction_Click"/>
                                                <Button Content="View GitHub ↗" Tag="{Binding}" Style="{StaticResource PillButton}" Margin="0,9,0,0" Click="OpenGithub_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyCatalogText" Text="No catalogue mods yet. Add an approved GitHub repo under Settings / Curator, or connect a hosted catalogue URL." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="6,15,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <!-- Installed -->
            <Grid x:Name="InstalledPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#182A33" CornerRadius="10" Padding="13" Margin="0,0,0,12">
                    <TextBlock Text="Mod changes are applied to the selected instance. Close OrbusVR before updating, disabling or uninstalling." Foreground="#BCD1D8" TextWrapping="Wrap" FontSize="12"/>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding InstalledMods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Version}" Foreground="#66D7BB" FontSize="12" Margin="0,5,0,0"/>
                                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                                <Button Content="{Binding Action}" Tag="{Binding}" IsEnabled="{Binding CanClick}" Style="{StaticResource PrimaryButton}" Click="InstalledToggle_Click"/>
                                                <Button Content="Uninstall" Tag="{Binding}" IsEnabled="{Binding CanClick}" Style="{StaticResource PillButton}" Click="InstalledUninstall_Click" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyInstalledText" Text="No managed mods yet. Use Discover or Import local DLL on the dashboard." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="6,15,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <!-- Settings + curation -->
            <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="ONLINE CURATED CATALOGUE" FontSize="11" FontWeight="Bold" Foreground="#66D7BB"/>
                            <TextBlock Text="Link to a raw HTTPS mods.json on GitHub. Everyone using that URL will see your approved mods and new releases automatically." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12"/>
                            <TextBox x:Name="CatalogUrlText" ToolTip="https://raw.githubusercontent.com/OWNER/OrbusRebornManager/main/catalog/mods.json"/>
                            <CheckBox x:Name="AutoUpdatesCheck" Content="Automatically update installed catalogue mods when the manager opens" IsChecked="True" Margin="0,17,0,15"/>
                            <Button Content="Save settings &amp; refresh" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="SaveSettings_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="CURATOR TOOLS  /  LOCAL DRAFTS" Foreground="#66D7BB" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Text="Paste an approved GitHub repository here. It creates a local draft, not a public listing. Export the catalogue JSON and commit it to your catalogue repository when you're happy with the listing." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12"/>
                            <TextBlock Text="GitHub repository URL" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox x:Name="NewRepoText"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Display name (optional)" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBox x:Name="NewNameText"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Release asset pattern" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBox x:Name="NewAssetText" Text="*.dll"/>
                                </StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,16,0,0">
                                <Button Content="Add local draft" Style="{StaticResource PrimaryButton}" Click="AddDraft_Click" Margin="0,0,10,0"/>
                                <Button Content="Export curated mods.json" Style="{StaticResource PillButton}" Click="ExportCatalog_Click"/>
                            </WrapPanel>
                            <TextBlock Text="Tip: every public mod needs a published GitHub Release with exactly one asset matching its pattern (.dll or .zip)." Foreground="#8193A9" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <!-- Status bar -->
            <Border Grid.Row="2" Background="#101B29" CornerRadius="9" Padding="13,10" Margin="0,16,0,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusLine" Text="Ready. Select an OrbusVR Reborn game folder to begin." Foreground="#B4C8D9" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="ActivityBar" Grid.Column="1" Width="92" Height="4" Foreground="#66D7BB" Background="#2B3546" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
