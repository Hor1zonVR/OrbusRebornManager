
<Application x:Class="OrbusRebornManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Neutral launcher palette: accent is for actions, not every label. -->
        <FontFamily x:Key="InterfaceFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="HeadingFont">Segoe UI Variable Display, Segoe UI</FontFamily>

        <SolidColorBrush x:Key="BackgroundBrush" Color="#17181D"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#202127"/>
        <SolidColorBrush x:Key="CardBrush" Color="#25262D"/>
        <SolidColorBrush x:Key="CardAltBrush" Color="#303139"/>
        <SolidColorBrush x:Key="StrokeBrush" Color="#393B44"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A0A3B0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#57D9AC"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F5F7"/>

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#27282F"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#3B3D45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="#327C67"/>
            <Setter Property="MinHeight" Value="37"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Foreground" Value="#BBCADB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#33343D"/>
            <Setter Property="BorderBrush" Value="#41434D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- The custom template draws a focus border instead of WPF's
                 default dotted FocusVisualAdorner. -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Shell" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.83"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.67"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.40"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button"
               BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#0F2821"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- Card action icons are real vector geometry, not font glyphs.
             Segoe MDL2's private-use symbols rendered as boxes on some PCs. -->
        <DataTemplate x:Key="InstanceMoreIcon">
            <Viewbox Width="17" Height="17" Stretch="Uniform" IsHitTestVisible="False">
                <Canvas Width="18" Height="18">
                    <Ellipse Canvas.Left="2" Canvas.Top="7.25" Width="3.5" Height="3.5"
                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <Ellipse Canvas.Left="7.25" Canvas.Top="7.25" Width="3.5" Height="3.5"
                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <Ellipse Canvas.Left="12.5" Canvas.Top="7.25" Width="3.5" Height="3.5"
                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="InstancePlayIcon">
            <Viewbox Width="17" Height="17" Stretch="Uniform" IsHitTestVisible="False">
                <Canvas Width="18" Height="18">
                    <Path Data="M 5,2.5 L 15,9 L 5,15.5 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8" StrokeLineJoin="Round"
                          Fill="Transparent"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <Style x:Key="InstanceMoreButton" BasedOn="{StaticResource PillButton}" TargetType="Button">
            <Setter Property="Background" Value="#333540"/>
            <Setter Property="BorderBrush" Value="#444650"/>
            <Setter Property="Foreground" Value="#EDF0F5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="ContentTemplate" Value="{StaticResource InstanceMoreIcon}"/>
        </Style>

        <Style x:Key="InstancePlayButton" BasedOn="{StaticResource PrimaryButton}" TargetType="Button">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="ContentTemplate" Value="{StaticResource InstancePlayIcon}"/>
        </Style>

        <!-- Compact table actions: the switch reflects the actual
             InstalledMod.Enabled value and uses the existing safe toggle handler. -->
        <Style x:Key="ModSwitchButton" TargetType="Button">
            <Setter Property="Width" Value="43"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTip" Value="Enable or disable this mod"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Track" Background="#51535D"
                                Width="42" Height="23" CornerRadius="12"
                                BorderBrush="#636670" BorderThickness="1">
                            <Border x:Name="Knob" Width="17" Height="17"
                                    Background="#FFFFFF" CornerRadius="9"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Margin="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Installed.Enabled}" Value="True">
                                <Setter TargetName="Track" Property="Background"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Knob" Property="Background" Value="#173A31"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="Track" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModIconActionButton" TargetType="Button">
            <Setter Property="Width" Value="31"/>
            <Setter Property="Height" Value="31"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#373841"/>
                                <Setter Property="Foreground" Value="#F4F5F7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Surface" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButton" TargetType="Button"
               BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="39"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Reusable logo derived from the user's supplied Orbus cube artwork.
             Vector graphics stay sharp at 100%, 125% and 200% DPI. -->
        <DataTemplate x:Key="OrbusMark">
            <Viewbox Stretch="Uniform">
                <Canvas Width="100" Height="100">
                    <Polygon Points="50,2 96,29 50,57 4,29" Fill="#B56AAF"/>
                    <Polygon Points="4,29 50,57 50,98 4,73" Fill="#CA84B3"/>
                    <Polygon Points="96,29 96,73 50,98 50,57" Fill="#A75DA6"/>
                    <Polygon Points="50,23 79,40 79,66 50,82 21,66 21,40" Fill="White"/>
                    <Polygon Points="50,30 72,43 50,56 28,43" Fill="#7FCB93"/>
                    <Polygon Points="28,43 50,56 50,75 28,63" Fill="#F28B27"/>
                    <Polygon Points="72,43 72,63 50,75 50,56" Fill="#8C60A9"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeSurface" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeSurface" Property="Background" Value="#383940"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeSurface" Property="Background" Value="#41424A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseChromeButton" BasedOn="{StaticResource ChromeButton}" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#B83B42"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#922B31"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Decorative, Orbus-inspired arcane geometry.
             These are original motifs, not exact spellcast glyph transcriptions.
             Authentic Greater Fireball/Affliction strokes can replace the templates
             after reference artwork is supplied. -->
        <DataTemplate x:Key="ArcaneRingMotif">
            <Viewbox Stretch="Uniform">
                <Canvas Width="280" Height="280">
                    <Ellipse Canvas.Left="25" Canvas.Top="25" Width="230" Height="230"
                             Stroke="#B8A0DC" StrokeThickness="3"/>
                    <Ellipse Canvas.Left="53" Canvas.Top="53" Width="174" Height="174"
                             Stroke="#B8A0DC" StrokeThickness="2"/>
                    <Path Stroke="#B8A0DC" StrokeThickness="3"
                          Data="M 140,15 L 181,96 L 265,140 L 181,184 L 140,265 L 99,184 L 15,140 L 99,96 Z"/>
                    <Path Stroke="#B8A0DC" StrokeThickness="2"
                          Data="M 140,54 L 190,140 L 140,226 L 90,140 Z"/>
                    <Ellipse Canvas.Left="131" Canvas.Top="131" Width="18" Height="18"
                             Stroke="#B8A0DC" StrokeThickness="2"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="ArcaneSpiralMotif">
            <Viewbox Stretch="Uniform">
                <Canvas Width="300" Height="300">
                    <Ellipse Canvas.Left="38" Canvas.Top="38" Width="224" Height="224"
                             Stroke="#83C2B5" StrokeThickness="3"/>
                    <Path Stroke="#83C2B5" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 144,40 C 216,29 271,96 245,168 C 227,218 170,251 117,225 C 70,202 67,150 101,116 C 122,94 169,91 190,120 C 207,145 196,177 170,187 C 147,197 123,177 132,156"/>
                    <Path Stroke="#83C2B5" StrokeThickness="3"
                          Data="M 150,0 L 150,39 M 150,261 L 150,300 M 0,150 L 39,150 M 261,150 L 300,150"/>
                    <Path Stroke="#83C2B5" StrokeThickness="2"
                          Data="M 49,49 L 77,77 M 251,49 L 223,77 M 49,251 L 77,223 M 251,251 L 223,223"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="ArcaneHexMotif">
            <Viewbox Stretch="Uniform">
                <Canvas Width="280" Height="280">
                    <Path Stroke="#C9A1C9" StrokeThickness="3"
                          Data="M 140,18 L 246,79 L 246,201 L 140,262 L 34,201 L 34,79 Z"/>
                    <Path Stroke="#C9A1C9" StrokeThickness="2"
                          Data="M 140,53 L 216,96 L 216,184 L 140,227 L 64,184 L 64,96 Z"/>
                    <Path Stroke="#C9A1C9" StrokeThickness="3"
                          Data="M 140,18 L 140,262 M 34,79 L 246,201 M 246,79 L 34,201"/>
                    <Ellipse Canvas.Left="123" Canvas.Top="123" Width="34" Height="34"
                             Fill="#C9A1C9" Opacity="0.22"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Native Windows context menus default to a light popup. Provide a
             dark, consistently readable menu for instance cards. -->
        <Style x:Key="InstanceContextMenu" TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="MinWidth" Value="196"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InstanceMenuItem" TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="HitArea" Background="Transparent"
                                CornerRadius="9" Margin="3,2" Padding="13,10">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="HitArea" Property="Background"
                                        Value="{StaticResource CardAltBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckSurface" Width="18" Height="18" CornerRadius="5"
                                    VerticalAlignment="Center"
                                    Background="#282A31" BorderBrush="#777A82"
                                    BorderThickness="1">
                                <TextBlock x:Name="Tick" Text="&#xE73E;"
                                           Foreground="#0D2B20"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter ContentSource="Content" Margin="9,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckSurface" Property="Background"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckSurface" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
