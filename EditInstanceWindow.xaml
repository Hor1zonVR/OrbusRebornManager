<Window x:Class="OrbusRebornManager.EditInstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Customize instance" Width="765" Height="576"
        ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource InterfaceFont}"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource BackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="39"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="13,0,0,0">
                        <ContentControl Width="25" Height="25"
                                        ContentTemplate="{StaticResource OrbusMark}"/>
                        <TextBlock Text="Customize instance" Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Content="×" FontFamily="Segoe UI" FontSize="19"
                            Style="{StaticResource CloseChromeButton}"
                            HorizontalAlignment="Right" Click="Cancel_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,20,24,19">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="Customize instance" FontSize="23"
                               FontFamily="{StaticResource HeadingFont}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Your cover will look exactly like this in your library."
                               Foreground="{StaticResource MutedBrush}" FontSize="13"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="352"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource StrokeBrush}"
                            BorderThickness="1" CornerRadius="15" Padding="11">
                        <StackPanel>
                            <Border x:Name="PreviewBox" Width="328" Height="274"
                                    CornerRadius="12" ClipToBounds="True"
                                    Background="#344153"
                                    AllowDrop="True"
                                    DragOver="Cover_DragOver" Drop="Cover_Drop">
                                <Grid ClipToBounds="True">
                                    <ContentControl x:Name="DefaultIcon"
                                                    ContentTemplate="{StaticResource OrbusMark}"
                                                    Width="137" Height="137"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                    <Image x:Name="CustomIcon" Width="328" Height="274"
                                           Stretch="UniformToFill"
                                           RenderTransformOrigin="0.5,0.5"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="PreviewScale"/>
                                                <TranslateTransform x:Name="PreviewMove"/>
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="PreviewName" FontSize="15"
                                       FontWeight="SemiBold" Margin="3,10,0,0"/>
                            <TextBlock x:Name="PreviewKind" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="3,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="21,7,0,0">
                        <TextBlock Text="Cover artwork" FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="ImageStatusText" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,7,0,14"/>
                        <Button Content="Choose image and crop"
                                Style="{StaticResource PrimaryButton}"
                                Click="ChooseImage_Click"
                                MinHeight="42" Margin="0,0,0,10"/>
                        <Button x:Name="AdjustCropButton" Content="Adjust current crop"
                                Style="{StaticResource PillButton}"
                                Click="AdjustCrop_Click"
                                MinHeight="37" Margin="0,0,0,10"/>
                        <Button Content="Use default Orbus artwork"
                                Style="{StaticResource PillButton}"
                                Click="ClearImage_Click"
                                MinHeight="37"/>
                        <TextBlock Text="Choosing an image opens the crop tool. You'll see the full photo before deciding what to keep."
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,18,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,15,0,0">
                    <TextBlock Text="Instance name" FontSize="13"
                               FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <TextBox x:Name="NameText" MinHeight="39" MaxLength="50"
                             TextChanged="NameText_TextChanged"
                             Padding="12,8" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="0,1,0,0" Padding="24,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Your original game and source image stay unchanged."
                               VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource MutedBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancel" Click="Cancel_Click"
                                Style="{StaticResource PillButton}"
                                MinWidth="85" Margin="0,0,9,0"/>
                        <Button Content="Save changes" Click="Save_Click"
                                Style="{StaticResource PrimaryButton}" MinWidth="132"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>