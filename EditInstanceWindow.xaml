<Window x:Class="OrbusRebornManager.EditInstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Customize instance"
        Width="798" Height="690" MinWidth="798" MinHeight="690"
        ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource InterfaceFont}"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource BackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="39"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="13,0,0,0">
                        <ContentControl Width="25" Height="25"
                                        ContentTemplate="{StaticResource OrbusMark}"/>
                        <TextBlock Text="Customize instance" Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Content="×" FontFamily="Segoe UI" FontSize="19"
                            Style="{StaticResource CloseChromeButton}"
                            HorizontalAlignment="Right" Click="Cancel_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,22,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="Make it yours" FontSize="24" FontWeight="SemiBold"
                               FontFamily="{StaticResource HeadingFont}"/>
                    <TextBlock Text="Choose your cover, move it into place, and see exactly how it'll appear in the library."
                               FontSize="13" Foreground="{StaticResource MutedBrush}"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="365"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- The preview art is exactly 2x the library's 164x137 layout. -->
                    <Border Background="{StaticResource CardBrush}"
                            CornerRadius="16" BorderBrush="{StaticResource StrokeBrush}"
                            BorderThickness="1" Padding="17">
                        <StackPanel>
                            <TextBlock Text="LIBRARY PREVIEW" FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,12"/>
                            <Border x:Name="PreviewBox" Width="328" Height="274"
                                    Background="#354253" CornerRadius="13"
                                    ClipToBounds="True" Cursor="SizeAll"
                                    AllowDrop="True"
                                    ToolTip="Drag to reposition. Scroll to zoom. You can also drop a PNG, JPG or BMP here."
                                    MouseLeftButtonDown="Preview_MouseLeftButtonDown"
                                    MouseLeftButtonUp="Preview_MouseLeftButtonUp"
                                    MouseMove="Preview_MouseMove"
                                    MouseWheel="Preview_MouseWheel"
                                    DragOver="Preview_DragOver"
                                    Drop="Preview_Drop"
                                    LostMouseCapture="Preview_LostMouseCapture">
                                <Grid ClipToBounds="True">
                                    <ContentControl x:Name="DefaultIcon" Width="140" Height="140"
                                                    ContentTemplate="{StaticResource OrbusMark}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                    <Image x:Name="BlurredPreview" Width="328" Height="274"
                                           Stretch="UniformToFill" Opacity="0.28"
                                           Visibility="Collapsed" IsHitTestVisible="False">
                                        <Image.Effect>
                                            <BlurEffect Radius="13"/>
                                        </Image.Effect>
                                    </Image>
                                    <Image x:Name="CustomIcon" Width="328" Height="274"
                                           Stretch="UniformToFill" Visibility="Collapsed"
                                           RenderTransformOrigin="0.5,0.5"
                                           IsHitTestVisible="False">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="PreviewScale"/>
                                                <TranslateTransform x:Name="PreviewMove"/>
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="PreviewName" Text="My Instance"
                                       FontSize="16" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="3,14,0,0"/>
                            <TextBlock x:Name="PreviewKind" Text="Modded copy"
                                       FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       Margin="3,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="22,2,0,0">
                        <TextBlock Text="Cover artwork" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ImageStatusText" Text="Default Orbus cover"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,6,0,13"/>

                        <Button Content="Choose an image"
                                Style="{StaticResource PrimaryButton}"
                                Click="ChooseImage_Click" MinHeight="37"
                                HorizontalAlignment="Stretch" Margin="0,0,0,9"/>
                        <Button Content="Use default Orbus artwork"
                                Style="{StaticResource PillButton}"
                                Click="ClearImage_Click" MinHeight="35"
                                HorizontalAlignment="Stretch" Margin="0,0,0,17"/>

                        <TextBlock Text="IMAGE SIZE" Style="{StaticResource Eyebrow}"
                                   Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="FillButton" Content="Fill cover"
                                    Tag="Fill" Style="{StaticResource PillButton}"
                                    Click="Fill_Click" MinHeight="36" Padding="9,7"/>
                            <Button x:Name="FitButton" Grid.Column="2" Content="Fit image"
                                    Tag="Fit" Style="{StaticResource PillButton}"
                                    Click="Fit_Click" MinHeight="36" Padding="9,7"/>
                        </Grid>
                        <TextBlock Text="Fill crops the edges. Fit keeps the whole picture visible."
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,8,0,17"/>

                        <TextBlock Text="ZOOM" Style="{StaticResource Eyebrow}"
                                   Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="42"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ZoomOutButton" Content="−" FontSize="20"
                                    Style="{StaticResource PillButton}"
                                    Click="ZoomOut_Click" Padding="0"
                                    MinHeight="36" Height="36"/>
                            <Border Grid.Column="1" Background="#303139"
                                    CornerRadius="9" Margin="8,0"
                                    Height="36">
                                <TextBlock x:Name="ZoomValue" Text="100%"
                                           FontSize="14" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <Button x:Name="ZoomInButton" Grid.Column="2" Content="+"
                                    FontSize="20" Style="{StaticResource PillButton}"
                                    Click="ZoomIn_Click" Padding="0"
                                    MinHeight="36" Height="36"/>
                        </Grid>
                        <TextBlock Text="Drag to move · Scroll to zoom"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,9,0,0"/>
                        <Button Content="Reset crop"
                                Style="{StaticResource PillButton}"
                                Click="ResetFraming_Click"
                                MinHeight="33" Padding="9,6"
                                HorizontalAlignment="Right" Margin="0,16,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <TextBlock Text="Instance name" FontSize="13" FontWeight="SemiBold"
                               Margin="0,0,0,7"/>
                    <TextBox x:Name="NameText" MinHeight="39" MaxLength="50"
                             TextChanged="NameText_TextChanged"
                             VerticalContentAlignment="Center" Padding="12,8"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0"
                    Padding="24,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Changes affect this instance only."
                               FontSize="12" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancel" Click="Cancel_Click"
                                Style="{StaticResource PillButton}"
                                Margin="0,0,9,0" MinWidth="85"/>
                        <Button Content="Save changes" Click="Save_Click"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="132"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>