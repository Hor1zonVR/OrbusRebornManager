<Window x:Class="OrbusRebornManager.EditInstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Customize instance" Width="690" Height="700"
        ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource InterfaceFont}"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource BackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="39"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="13,0,0,0">
                        <ContentControl Width="25" Height="25"
                                        ContentTemplate="{StaticResource OrbusMark}"/>
                        <TextBlock Text="Customize instance" Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Content="×" FontFamily="Segoe UI" FontSize="19"
                            Style="{StaticResource CloseChromeButton}"
                            HorizontalAlignment="Right" Click="Cancel_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="25,20,25,15">
                    <TextBlock Text="Customize your instance" FontSize="22"
                               FontWeight="SemiBold" FontFamily="{StaticResource HeadingFont}"/>
                    <TextBlock Text="Give your installation a name and artwork that feel like yours."
                               FontSize="13" Foreground="{StaticResource MutedBrush}"
                               Margin="0,5,0,17"/>

                    <TextBlock Text="Display name" FontSize="13" FontWeight="SemiBold"
                               Margin="0,0,0,7"/>
                    <TextBox x:Name="NameText" MinHeight="38" MaxLength="50"
                             VerticalContentAlignment="Center" Padding="12,8"/>
                    <TextBlock Text="The name changes only in your library, not in the game folder."
                               FontSize="12" Foreground="{StaticResource MutedBrush}"
                               Margin="0,7,0,17"/>

                    <TextBlock Text="Instance cover" FontSize="14" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="14"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                            Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Border x:Name="PreviewBox" Width="164" Height="137"
                                        HorizontalAlignment="Left"
                                        CornerRadius="12"
                                        Background="#354253" ClipToBounds="True"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="Preview_MouseLeftButtonDown"
                                        MouseLeftButtonUp="Preview_MouseLeftButtonUp"
                                        MouseMove="Preview_MouseMove"
                                        LostMouseCapture="Preview_LostMouseCapture">
                                    <Grid ClipToBounds="True">
                                        <ContentControl x:Name="DefaultIcon"
                                                        Width="76" Height="76"
                                                        ContentTemplate="{StaticResource OrbusMark}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                        <Image x:Name="BlurredPreview" Stretch="UniformToFill"
                                               Visibility="Collapsed" Opacity="0.28"
                                               IsHitTestVisible="False">
                                            <Image.Effect>
                                                <BlurEffect Radius="10"/>
                                            </Image.Effect>
                                        </Image>
                                        <Image x:Name="CustomIcon" Stretch="UniformToFill"
                                               RenderTransformOrigin="0.5,0.5"
                                               Visibility="Collapsed"
                                               IsHitTestVisible="False">
                                            <Image.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="PreviewScale"/>
                                                    <TranslateTransform x:Name="PreviewMove"/>
                                                </TransformGroup>
                                            </Image.RenderTransform>
                                        </Image>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Drag the image to reposition"
                                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           Margin="0,7,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="9,2,0,0">
                                <TextBlock x:Name="ImageStatusText"
                                           Text="Default Orbus artwork"
                                           FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Cover preview matches your library tile."
                                           FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           Margin="0,5,0,13"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Choose image"
                                            Click="ChooseImage_Click"
                                            Style="{StaticResource PillButton}"
                                            MinHeight="34" Padding="11,7" Margin="0,0,8,0"/>
                                    <Button Content="Use default"
                                            Click="ClearImage_Click"
                                            Style="{StaticResource PillButton}"
                                            MinHeight="34" Padding="11,7"/>
                                </StackPanel>
                                <CheckBox x:Name="FitImageCheck"
                                          Content="Show entire image (fit)"
                                          Checked="ArtworkControls_Changed"
                                          Unchecked="ArtworkControls_Changed"
                                          FontSize="12" Margin="0,19,0,0"/>
                                <TextBlock Text="Fill crops the edges; Fit keeps the whole picture."
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="0,17,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Framing" FontSize="13" FontWeight="SemiBold"/>
                        <Button Grid.Column="1" Content="Reset framing"
                                Click="ResetFraming_Click"
                                Style="{StaticResource PillButton}"
                                Padding="9,5" MinHeight="29" FontSize="11"/>
                    </Grid>
                    <StackPanel x:Name="FramingControls" Margin="0,6,0,0">
                        <Grid Margin="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="47"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Zoom" VerticalAlignment="Center" FontSize="12"/>
                            <Slider x:Name="ZoomSlider" Grid.Column="1"
                                    Minimum="1" Maximum="2.5" Value="1"
                                    ValueChanged="ArtworkSlider_Changed"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="ZoomValue" Grid.Column="2"
                                       Text="100%" FontSize="12"
                                       TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,6,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="47"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Horizontal" VerticalAlignment="Center" FontSize="12"/>
                            <Slider x:Name="XSlider" Grid.Column="1"
                                    Minimum="-80" Maximum="80" Value="0"
                                    ValueChanged="ArtworkSlider_Changed"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="XValue" Grid.Column="2"
                                       Text="0" TextAlignment="Right" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="47"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Vertical" VerticalAlignment="Center" FontSize="12"/>
                            <Slider x:Name="YSlider" Grid.Column="1"
                                    Minimum="-80" Maximum="80" Value="0"
                                    ValueChanged="ArtworkSlider_Changed"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="YValue" Grid.Column="2"
                                       Text="0" TextAlignment="Right" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="Images are saved in RebornManager's AppData (PNG, JPG or BMP, up to 12 MB)."
                               FontSize="11" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,16,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0"
                    Padding="24,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="Cancel_Click"
                            Style="{StaticResource PillButton}" Margin="0,0,9,0"
                            MinWidth="89"/>
                    <Button Content="Save changes" Click="Save_Click"
                            Style="{StaticResource PrimaryButton}" MinWidth="135"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>