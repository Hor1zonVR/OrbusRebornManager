<Window x:Class="OrbusRebornManager.CreateInstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Create instance"
        Width="624" Height="800"
        ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource InterfaceFont}"
        Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Grid Background="{StaticResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Faint background motif, original Orbus-inspired geometry.
                 It is decorative and never overlaps input hit targets. -->
            <Canvas Grid.Row="1" IsHitTestVisible="False" ClipToBounds="True"
                    Opacity="0.042">
                <Viewbox Width="215" Height="215" Canvas.Top="-45" Canvas.Right="-30">
                    <Canvas Width="110" Height="110">
                        <Path Data="M 20,12 L 22,98 M 22,12 L 85,44 L 22,65 L 90,87"
                              Stroke="#8CD2B2" StrokeThickness="7"
                              StrokeLineJoin="Round" Fill="Transparent"/>
                    </Canvas>
                </Viewbox>
            </Canvas>

            <Border Grid.Row="0" Background="#202127" BorderBrush="#393A43"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="13,0,0,0"
                                VerticalAlignment="Center">
                        <ContentControl ContentTemplate="{StaticResource OrbusMark}"
                                        Width="23" Height="23"/>
                        <TextBlock Text="New instance" Margin="9,0,0,0"
                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                   FontSize="13"/>
                    </StackPanel>
                    <Button Content="×" FontFamily="Segoe UI" FontSize="19"
                            Style="{StaticResource CloseChromeButton}"
                            Click="Chrome_Close_Click"
                            HorizontalAlignment="Right" ToolTip="Close"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="25,20,25,0">
                <TextBlock Text="Create an instance" FontSize="23" FontWeight="SemiBold"
                           FontFamily="{StaticResource HeadingFont}"/>
                <TextBlock Text="Download or copy an isolated OrbusVR PC installation."
                           FontSize="13" Foreground="{StaticResource MutedBrush}"
                           Margin="0,4,0,18"/>

                <TextBlock Text="Name" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,7"/>
                <TextBox x:Name="NameText" MaxLength="50" Text="Modded Orbus"
                         FontSize="13.5" Padding="11,8" MinHeight="38"/>

                <TextBlock Text="Game edition" FontSize="13" FontWeight="SemiBold" Margin="0,15,0,7"/>
                <!-- The native Windows ComboBox popup ignored theme colours.
                     Use fully themed, keyboard-accessible cards instead. -->
                <ComboBox x:Name="EditionChoice" Visibility="Collapsed"
                          SelectedIndex="0" SelectionChanged="EditionChoice_Changed">
                    <ComboBoxItem Content="Community"/>
                    <ComboBoxItem Content="Renewed"/>
                    <ComboBoxItem Content="Existing"/>
                </ComboBox>
                <StackPanel>
                    <Button x:Name="CommunityEditionCard" Tag="0"
                            Style="{StaticResource PillButton}" HorizontalContentAlignment="Stretch"
                            Click="EditionCard_Click" Padding="14,10" Margin="0,0,0,6"
                            Background="#273E3A" BorderBrush="#57D9AC">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="CommunityEditionIndicator" Text="✓" FontSize="17" FontWeight="Bold"
                                       Foreground="#57D9AC" DockPanel.Dock="Right"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Community Edition" FontSize="14"
                                           FontWeight="SemiBold" Foreground="#F4F5F7"/>
                                <TextBlock Text="Original community game · download latest"
                                           FontSize="12" Foreground="#B8C2CF" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                    <Button x:Name="RenewedEditionCard" Tag="1"
                            Style="{StaticResource PillButton}" HorizontalContentAlignment="Stretch"
                            Click="EditionCard_Click" Padding="14,10" Margin="0,0,0,6">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="RenewedEditionIndicator" Text="›" FontSize="20" Foreground="#B8C2CF"
                                       DockPanel.Dock="Right" Margin="10,0,0,0"/>
                            <StackPanel>
                                <TextBlock Text="Orbus Renewed · FourOfSpades" FontSize="14"
                                           FontWeight="SemiBold" Foreground="#F4F5F7"/>
                                <TextBlock Text="Enhanced client · download latest"
                                           FontSize="12" Foreground="#B8C2CF" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                    <Button x:Name="LocalEditionCard" Tag="2"
                            Style="{StaticResource PillButton}" HorizontalContentAlignment="Stretch"
                            Click="EditionCard_Click" Padding="14,10">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="LocalEditionIndicator" Text="›" FontSize="20" Foreground="#B8C2CF"
                                       DockPanel.Dock="Right" Margin="10,0,0,0"/>
                            <StackPanel>
                                <TextBlock Text="Existing installation" FontSize="14"
                                           FontWeight="SemiBold" Foreground="#F4F5F7"/>
                                <TextBlock Text="Create a clean copy of your installed game"
                                           FontSize="12" Foreground="#B8C2CF" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="EditionInfo" FontSize="12" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" Margin="0,7,0,0"
                           Text="RM will download the official PC game release directly from GitHub."/>
                <Grid x:Name="ExistingSourceHeading" Margin="0,16,0,7" Visibility="Collapsed">
                    <TextBlock Text="Copy from" FontWeight="SemiBold" FontSize="13"/>
                </Grid>
                <Border x:Name="ExistingSourcePanel" Visibility="Collapsed"
                        Background="{StaticResource CardBrush}" CornerRadius="15"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                        Padding="13,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                            <TextBlock Text="OrbusVR installation" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock x:Name="SourceLocationLabel" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Change"
                                Style="{StaticResource PillButton}" Padding="12,7"
                                Click="BrowseSource_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <TextBlock Text="Save to" FontSize="13" FontWeight="SemiBold"
                           Margin="0,15,0,7"/>
                <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                        Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                            <TextBlock Text="Instance library" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock x:Name="StorageLocationLabel" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Change"
                                Style="{StaticResource PillButton}" Padding="12,7"
                                Click="BrowseStorage_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                        Margin="0,17,0,0" Padding="12,10">
                    <StackPanel>
                        <CheckBox x:Name="LoaderCheck" Content="Prepare for mods"
                                  IsChecked="True" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="LoaderInfo" Text="Install BepInEx only in the newly created instance."
                                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   Margin="22,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Values retained for safe-copy logic; summaries above are the UI. -->
                <TextBox x:Name="SourcePathText" Visibility="Collapsed"/>
                <TextBox x:Name="StoragePathText" Visibility="Collapsed"/>
                <CheckBox x:Name="RememberLocationCheck" IsChecked="True"
                          Visibility="Collapsed"/>
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="0,1,0,0" Padding="24,13,24,16"
                    Background="#202127">
                <StackPanel>
                    <TextBlock x:Name="CreationStatusText" FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,7"/>
                    <ProgressBar x:Name="CopyProgress" Visibility="Collapsed" Maximum="100"
                                 Height="4" Foreground="{StaticResource AccentBrush}"
                                 Margin="0,0,0,9"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Content="Cancel"
                                Style="{StaticResource PillButton}"
                                Click="Cancel_Click" Margin="0,0,9,0" MinWidth="85"/>
                        <Button x:Name="CreateButton" Content="Create instance"
                                Style="{StaticResource PrimaryButton}" Click="Create_Click"
                                MinWidth="143"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
