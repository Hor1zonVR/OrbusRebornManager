<Window x:Class="OrbusRebornManager.CreateInstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create an OrbusVR instance"
        Width="700" Height="660"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        Closing="Window_Closing">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,23">
            <TextBlock Text="NEW INSTANCE"
                       Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Create an instance"
                       FontSize="27" FontWeight="Bold" Margin="0,8,0,5"/>
            <TextBlock Text="A separate copy of OrbusVR for your mods."
                       FontSize="13" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1" CornerRadius="14"
                Padding="23">
            <StackPanel>
                <TextBlock Text="Instance name" FontWeight="SemiBold" FontSize="13"/>
                <TextBox x:Name="NameText" Margin="0,9,0,6"
                         MaxLength="50" Text="Modded Orbus"/>
                <TextBlock Text="Use letters, numbers, spaces, hyphens or underscores."
                           Foreground="{StaticResource MutedBrush}" FontSize="11"/>

                <TextBlock Text="Copy from" FontWeight="SemiBold"
                           FontSize="13" Margin="0,22,0,9"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SourcePathText" IsReadOnly="True"
                             ToolTip="Your existing OrbusVR installation"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="Browse"
                            Style="{StaticResource PillButton}"
                            Click="BrowseSource_Click" Margin="9,0,0,0"/>
                </Grid>
                <TextBlock Text="The source installation will not be modified."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11" Margin="0,7,0,0"/>

                <TextBlock Text="Save instances in" FontWeight="SemiBold"
                           FontSize="13" Margin="0,21,0,9"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="StoragePathText" IsReadOnly="True"
                             ToolTip="Where your new instances are stored"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="Change"
                            Style="{StaticResource PillButton}"
                            Click="BrowseStorage_Click" Margin="9,0,0,0"/>
                </Grid>
                <CheckBox x:Name="RememberLocationCheck"
                          Content="Use this folder for future instances"
                          IsChecked="True" Margin="0,12,0,0"/>

                <Border Background="{StaticResource CardAltBrush}"
                        CornerRadius="10" Margin="0,22,0,0" Padding="13">
                    <StackPanel>
                        <CheckBox x:Name="LoaderCheck" IsChecked="True"
                                  Content="Prepare for mods"/>
                        <TextBlock Text="Automatically install the BepInEx mod loader into your new copy."
                                   FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   Margin="22,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock x:Name="CreationStatusText"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <ProgressBar x:Name="CopyProgress" Height="5" Maximum="100"
                         Visibility="Collapsed" Margin="0,0,0,14"
                         Foreground="{StaticResource AccentBrush}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" x:Name="CancelButton" Content="Cancel"
                        Style="{StaticResource PillButton}"
                        Click="Cancel_Click" Margin="0,0,10,0"/>
                <Button Grid.Column="2" x:Name="CreateButton" Content="Create instance"
                        Style="{StaticResource PrimaryButton}" Click="Create_Click"
                        MinWidth="145"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
