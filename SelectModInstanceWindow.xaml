<Window x:Class="OrbusRebornManager.SelectModInstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose install target" Width="620" Height="525"
        MinWidth="540" MinHeight="440" ResizeMode="NoResize"
        WindowStyle="None" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource InterfaceFont}">
    <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="39"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#202127" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_Drag">
                <Grid>
                    <TextBlock Text="Choose installation" Margin="17,0,0,0" FontSize="13"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="×" Width="40" HorizontalAlignment="Right"
                            Style="{StaticResource CloseChromeButton}"
                            Click="Cancel_Click" FontSize="18"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="24,19,24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Where should this mod be installed?"
                           FontSize="21" FontWeight="SemiBold"
                           FontFamily="{StaticResource HeadingFont}"/>
                <TextBlock x:Name="ModDescriptionText" Grid.Row="1"
                           FontSize="13" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,16"/>
                <ListBox Grid.Row="2" x:Name="InstanceOptions" Background="Transparent"
                         BorderThickness="0" Foreground="{StaticResource TextBrush}"
                         SelectionChanged="InstanceOptions_Changed"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                            <Setter Property="Margin" Value="0,0,4,9"/>
                            <Setter Property="Padding" Value="12"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{StaticResource StrokeBrush}"
                                                BorderThickness="1" CornerRadius="12"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#273F3A"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#343842"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Foreground="#F4F5F7"
                                           FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Detail}" Foreground="#BCC4D0"
                                           FontSize="12" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding Path}" Foreground="#8FA4BB"
                                           FontSize="11" TextTrimming="CharacterEllipsis"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <Border Grid.Row="2" Background="#202127" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="0,1,0,0" Padding="24,15">
                <Grid>
                    <TextBlock x:Name="SelectionHint" Text="Select one instance to continue."
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource PillButton}"
                                MinWidth="90" Margin="0,0,9,0" Click="Cancel_Click"/>
                        <Button x:Name="ConfirmButton" Content="Use this instance"
                                Style="{StaticResource PrimaryButton}"
                                IsEnabled="False" MinWidth="152" Click="Confirm_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
