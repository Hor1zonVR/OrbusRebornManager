<Window x:Class="OrbusRebornManager.CropInstanceCoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Crop instance cover" Width="798" Height="710"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource InterfaceFont}"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource BackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="13,0,0,0">
                        <ContentControl Width="25" Height="25"
                                        ContentTemplate="{StaticResource OrbusMark}"/>
                        <TextBlock Text="Crop cover image" Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Content="×" Style="{StaticResource CloseChromeButton}"
                            FontFamily="Segoe UI" FontSize="19"
                            HorizontalAlignment="Right" Click="Cancel_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="23,20,23,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Choose your cover" FontSize="23"
                               FontFamily="{StaticResource HeadingFont}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="The whole photo is shown below. Drag the crop grid to choose what will appear on your instance."
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Row="1" Background="#0D0F13"
                        BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="6">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- The full source photo is fitted into this 700x398 workspace.
                             Cropping is an overlaid selection, never an initial image crop. -->
                        <Canvas x:Name="CropCanvas" Width="700" Height="398"
                                Background="#101217" ClipToBounds="True"
                                Cursor="Hand"
                                MouseLeftButtonDown="Crop_MouseLeftButtonDown"
                                MouseLeftButtonUp="Crop_MouseLeftButtonUp"
                                MouseMove="Crop_MouseMove"
                                MouseWheel="Crop_MouseWheel"
                                LostMouseCapture="Crop_LostMouseCapture">
                            <Image x:Name="FullPhoto" IsHitTestVisible="False"
                                   Stretch="Fill"/>
                            <Rectangle x:Name="ShadeTop" Fill="#A0000000" IsHitTestVisible="False"/>
                            <Rectangle x:Name="ShadeBottom" Fill="#A0000000" IsHitTestVisible="False"/>
                            <Rectangle x:Name="ShadeLeft" Fill="#A0000000" IsHitTestVisible="False"/>
                            <Rectangle x:Name="ShadeRight" Fill="#A0000000" IsHitTestVisible="False"/>

                            <Border x:Name="CropFrame" BorderBrush="White"
                                    BorderThickness="2" IsHitTestVisible="False"
                                    Background="#01000000">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Column="1" Grid.RowSpan="3"
                                            BorderBrush="#AFFFFFFF"
                                            BorderThickness="1,0,1,0"
                                            IsHitTestVisible="False"/>
                                    <Border Grid.Row="1" Grid.ColumnSpan="3"
                                            BorderBrush="#AFFFFFFF"
                                            BorderThickness="0,1,0,1"
                                            IsHitTestVisible="False"/>
                                    <Border Width="12" Height="12" Background="White"
                                            BorderBrush="#30333C" BorderThickness="1"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="-5" Grid.Row="0" Grid.Column="0"/>
                                    <Border Width="12" Height="12" Background="White"
                                            BorderBrush="#30333C" BorderThickness="1"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="-5" Grid.Row="0" Grid.Column="2"/>
                                    <Border Width="12" Height="12" Background="White"
                                            BorderBrush="#30333C" BorderThickness="1"
                                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                            Margin="-5" Grid.Row="2" Grid.Column="0"/>
                                    <Border Width="12" Height="12" Background="White"
                                            BorderBrush="#30333C" BorderThickness="1"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="-5" Grid.Row="2" Grid.Column="2"/>
                                </Grid>
                            </Border>
                        </Canvas>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,13,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Drag to move  ·  Drag the corners to resize  ·  Scroll to adjust size"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        <TextBlock x:Name="CropInfo" Text="Cover ratio: 164:137"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="−" Click="Smaller_Click" FontSize="18"
                                Style="{StaticResource PillButton}"
                                MinHeight="32" Padding="10,5"/>
                        <TextBlock Text="Crop size" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="12,0" FontSize="12"/>
                        <Button Content="+" Click="Larger_Click" FontSize="18"
                                Style="{StaticResource PillButton}"
                                MinHeight="32" Padding="10,5" Margin="0,0,10,0"/>
                        <Button Content="Reset" Click="Reset_Click"
                                Style="{StaticResource PillButton}"
                                MinHeight="32" Padding="10,5"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0"
                    Padding="23,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Only the area inside the grid will be used."
                               VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource MutedBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancel" Style="{StaticResource PillButton}"
                                Click="Cancel_Click" MinWidth="90" Margin="0,0,9,0"/>
                        <Button Content="Use this crop" Style="{StaticResource PrimaryButton}"
                                Click="Confirm_Click" MinWidth="145"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>