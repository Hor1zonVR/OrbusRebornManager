
<Window x:Class="OrbusRebornManager.InstancesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage OrbusVR instances"
        Width="760" Height="665"
        MinWidth="640" MinHeight="570"
        WindowStartupLocation="CenterOwner"
        Background="#0A0F19"
        Foreground="#F2F7FC"
        FontFamily="Segoe UI">

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="GAME INSTANCES"
                       Foreground="#64E2C5"
                       FontSize="11"
                       FontWeight="Bold"/>

            <TextBlock Text="Your OrbusVR installations"
                       FontSize="25"
                       FontWeight="Bold"
                       Margin="0,7,0,0"/>

            <TextBlock Text="Keep your original game and create separate clean copies for testing mods."
                       Foreground="#9AAFC4"
                       FontSize="12"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource PanelCard}">
                    <StackPanel>
                        <TextBlock Text="YOUR INSTALLATIONS"
                                   Style="{StaticResource Eyebrow}"
                                   Margin="0,0,0,11"/>

                        <ListBox x:Name="InstancesList"
                                 Height="155"
                                 Background="#0D1624"
                                 Foreground="#F2F7FC"
                                 BorderBrush="#35475A"
                                 BorderThickness="1">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding"
                                            Value="9,8"/>
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"/>
                                        <TextBlock Text="{Binding Path}"
                                                   Foreground="#839BB1"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Use selected instance"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="UseSelected_Click"
                                    Margin="0,0,8,7"/>

                            <Button Content="Add existing game"
                                    Style="{StaticResource PillButton}"
                                    Click="AddExisting_Click"
                                    Margin="0,0,8,7"/>

                            <Button Content="Remove from list"
                                    Style="{StaticResource PillButton}"
                                    Click="Forget_Click"
                                    Margin="0,0,0,7"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelCard}"
                        Margin="0,15,0,0">
                    <StackPanel>
                        <TextBlock Text="CREATE A CLEAN COPY"
                                   Style="{StaticResource Eyebrow}"/>

                        <TextBlock Text="Copies game files from the selected installation. BepInEx and mods are NOT copied."
                                   Foreground="#9AAFC4"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,15"
                                   FontSize="12"/>

                        <TextBlock Text="New instance name"
                                   Margin="0,0,0,5"
                                   FontSize="12"/>

                        <TextBox x:Name="NewNameText"
                                 Text="Mod Testing"/>

                        <TextBlock Text="Folder where the new instance should be created"
                                   Margin="0,13,0,5"
                                   FontSize="12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="DestinationParentText"
                                     IsReadOnly="True"/>

                            <Button Grid.Column="1"
                                    Content="Browse"
                                    Click="BrowseParent_Click"
                                    Style="{StaticResource PillButton}"
                                    Margin="10,0,0,0"/>
                        </Grid>

                        <Button x:Name="CopyButton"
                                Content="Create instance"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left"
                                Margin="0,14,0,0"
                                Click="CreateCopy_Click"/>

                        <TextBlock x:Name="CopyStatus"
                                   Foreground="#9AAFC4"
                                   TextWrapping="Wrap"
                                   Margin="0,11,0,6"/>

                        <ProgressBar x:Name="CopyProgress"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="7"
                                     Foreground="#64E2C5"
                                     Background="#263548"
                                     Value="0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2"
                HorizontalAlignment="Right"
                Margin="0,15,0,0"
                Style="{StaticResource PillButton}"
                Content="Close"
                Click="Close_Click"/>
    </Grid>
</Window>
